---
import EmailLink from './EmailLink.astro';
import en from '../i18n/en';

const ui = en;

const quickLinks = [
  { label: ui.nav.training, href: '/dao-tao' },
  { label: ui.nav.consulting, href: '/tu-van' },
  { label: ui.nav.events, href: '/su-kien' },
  { label: ui.nav.about, href: '/gioi-thieu' },
  { label: ui.nav.research, href: '/nghien-cuu' },
  { label: ui.nav.insights, href: '/goc-nhin/' },
  { label: ui.nav.publications, href: '/cong-bo-khoa-hoc' },
  { label: ui.nav.contact, href: '/lien-he' },
];

---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <a class="site-footer__brand" href="/">
        {ui.siteName}
      </a>
      <p class="site-footer__title">{ui.footer.oneLineTitle}</p>
    </div>

    <div class="site-footer__nav">
      <h2 class="site-footer__heading">{ui.footer.quickLinks}</h2>
      <ul class="site-footer__links site-footer__links--quick">
        {quickLinks.map((item) => (
          <li>
            <a class="site-footer__link" href={item.href}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="site-footer__heading">{ui.footer.connect}</h2>
      <ul class="site-footer__links">
        <li>
          <a
            class="site-footer__link"
            href="https://scholar.google.com.vn/citations?user=lkYFFvAAAAAJ"
            target="_blank"
            rel="noopener noreferrer"
          >
            {ui.footer.googleScholar}
          </a>
        </li>
        <li>
          <a
            class="site-footer__link"
            href="https://orcid.org/0000-0002-7798-6635"
            target="_blank"
            rel="noopener noreferrer"
          >
            {ui.footer.orcid}
          </a>
        </li>
        <li>
          <a
            class="site-footer__link"
            href="https://www.linkedin.com/in/duydangpham/"
            target="_blank"
            rel="noopener noreferrer"
          >
            {ui.footer.linkedIn}
          </a>
        </li>
        <li>
          <EmailLink class="site-footer__link" label={ui.footer.email} />
        </li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>{ui.footer.copyright}</p>
  </div>
</footer>
