<script>
  const caseStates = ['before', 'after'] as const;
  type CaseState = (typeof caseStates)[number];

  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((component) => {
    const buttons = component.querySelectorAll<HTMLButtonElement>('.ba-btn');
    const images = component.querySelectorAll<HTMLImageElement>('.ba-img');
    const placeholders = component.querySelectorAll<HTMLElement>('.ba-placeholder');
    const readings = component.querySelectorAll<HTMLElement>('.ba-reading');

    const setState = (state: CaseState) => {
      buttons.forEach((button) => {
        const isActive = button.dataset.state === state;
        button.classList.toggle('active', isActive);
        button.classList.toggle('btn--primary', isActive);
        button.classList.toggle('btn--secondary', !isActive);
        button.setAttribute('aria-pressed', String(isActive));
      });
      images.forEach((image) => image.classList.toggle('active', image.dataset.state === state));
      placeholders.forEach((placeholder) =>
        placeholder.classList.toggle('active', placeholder.dataset.state === state),
      );
      readings.forEach((reading) => {
        const isActive = reading.dataset.state === state;
        reading.classList.toggle('active', isActive);
        reading.hidden = !isActive;
      });
    };

    images.forEach((image) => {
      const placeholder = component.querySelector<HTMLElement>(
        `.ba-placeholder[data-state="${image.dataset.state}"]`,
      );
      const showImage = () => placeholder?.classList.add('has-image');
      const hideImage = () => {
        image.hidden = true;
        placeholder?.classList.remove('has-image');
      };

      image.addEventListener('load', showImage);
      image.addEventListener('error', hideImage);
      if (image.complete) image.naturalWidth > 0 ? showImage() : hideImage();
    });

    buttons.forEach((button) =>
      button.addEventListener('click', () => setState(button.dataset.state as CaseState)),
    );
  });

  document.querySelectorAll<HTMLElement>('[data-case-story]').forEach((story) => {
    const panels = Array.from(story.querySelectorAll<HTMLElement>('[data-case-panel]'));
    const previousButton = story.querySelector<HTMLButtonElement>('[data-case-prev]');
    const nextButton = story.querySelector<HTMLButtonElement>('[data-case-next]');
    const currentStep = story.querySelector<HTMLElement>('[data-case-current]');
    const totalSteps = story.querySelector<HTMLElement>('[data-case-total]');
    const stepLabel = story.querySelector<HTMLElement>('[data-case-label]');
    let activeIndex = 0;

    const showPanel = (nextIndex: number, shouldScroll = true) => {
      activeIndex = Math.max(0, Math.min(nextIndex, panels.length - 1));

      panels.forEach((panel, index) => {
        const isActive = index === activeIndex;
        panel.hidden = !isActive;
        panel.classList.toggle('active', isActive);
        panel.setAttribute('aria-hidden', String(!isActive));
      });

      if (currentStep) currentStep.textContent = String(activeIndex + 1).padStart(2, '0');
      if (stepLabel) stepLabel.textContent = panels[activeIndex]?.dataset.label ?? '';
      if (previousButton) previousButton.disabled = activeIndex === 0;
      if (nextButton) nextButton.disabled = activeIndex === panels.length - 1;

      if (shouldScroll) {
        story.scrollIntoView({ behavior: 'auto', block: 'start' });
      }
    };

    previousButton?.addEventListener('click', () => showPanel(activeIndex - 1));
    nextButton?.addEventListener('click', () => showPanel(activeIndex + 1));

    story.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('button, summary, a, input, select, textarea')) return;

      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        showPanel(activeIndex - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        showPanel(activeIndex + 1);
      }
    });

    if (totalSteps) totalSteps.textContent = String(panels.length).padStart(2, '0');
    showPanel(0, false);
  });
</script>
