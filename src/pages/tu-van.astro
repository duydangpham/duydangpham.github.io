---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailLink from '../components/EmailLink.astro';
import { netiqSchema } from '../data/schema-organization';

const title = 'Tư vấn / Giải pháp';
const description =
  'NetIQ tư vấn ONA, chiến lược AI, chuyển đổi số và phát triển phần mềm theo yêu cầu cho nhu cầu thực tế của tổ chức.';
const canonicalUrl = '/tu-van/';

const netiqWebsite = 'https://www.netiq.vn';

const heroImages = {
  ai: '/images/tu-van/hero-ai-strategy-720x430.jpg',
  ona: '/images/tu-van/hero-ona-network-720x900.jpg',
  software: '/images/tu-van/hero-software-solutions-720x430.jpg',
};

const advisoryCards = [
  {
    title: 'Tư vấn ONA',
    tag: 'Network intelligence',
    text: 'Phân tích mạng lưới tổ chức để nhìn thấy ảnh hưởng, niềm tin, dòng tri thức, điểm nghẽn và những người có thể dẫn dắt thay đổi.',
    href: '/khai-niem/phan-tich-mang-luoi-to-chuc',
    linkLabel: 'Tìm hiểu ONA',
  },
  {
    title: 'Tư vấn AI & chuyển đổi số',
    tag: 'Strategy',
    text: 'Giúp lãnh đạo thiết kế lộ trình AI, chương trình AI champion, năng lực dữ liệu và cách tổ chức triển khai thay đổi có căn cứ.',
    href: '/khai-niem/nguoi-tien-phong-ai',
    linkLabel: 'Tìm hiểu AI Champion',
  },
  {
    title: 'Phát triển phần mềm theo yêu cầu',
    tag: 'Build',
    text: 'Tư vấn và phát triển phần mềm theo nhu cầu: từ digital platforms, data platforms, migration, automation đến các ứng dụng AI nội bộ.',
  },
];

const onaQuestions = [
  'Ai thật sự giữ ảnh hưởng trong tổ chức?',
  'Tri thức đang chảy đi đâu, và tắc ở đâu?',
  'Những lãnh đạo phi chính thức nào có thể đưa AI vào thực tế?',
  'Cấu trúc quan hệ nào đang thúc đẩy hoặc cản trở thay đổi?',
];

const softwareCapabilities = [
  {
    title: 'Nền tảng số',
    text: 'Nền tảng vận hành, cổng thông tin, portal thành viên, workflow nội bộ hoặc các hệ thống phục vụ khách hàng.',
    image: '/images/tu-van/software-digital-platforms-720x480.jpg',
  },
  {
    title: 'Nền tảng dữ liệu & chuyển đổi',
    text: 'Thiết kế cấu trúc dữ liệu, chuyển đổi dữ liệu, dashboard, reporting layer và các nền tảng hỗ trợ ra quyết định.',
    image: '/images/tu-van/software-data-platforms-720x480.jpg',
  },
  {
    title: 'Ứng dụng tích hợp AI',
    text: 'Ứng dụng AI cho tri thức nội bộ, tự động hoá nghiệp vụ, phân tích văn bản, chatbot hoặc copilot theo quy trình riêng.',
    image: '/images/tu-van/software-ai-applications-720x480.jpg',
  },
  {
    title: 'Giải pháp riêng theo yêu cầu',
    text: 'Nếu bài toán không nằm gọn trong một loại sản phẩm có sẵn, NetIQ có team để tư vấn, thiết kế và phát triển giải pháp phù hợp.',
    image: '/images/tu-van/software-custom-solutions-720x480.jpg',
  },
];

const deliverySteps = [
  {
    label: 'Khám phá',
    text: 'Hiểu bài toán, stakeholder, dữ liệu, constraint vận hành và quyết định kinh doanh cần hỗ trợ.',
  },
  {
    label: 'Thiết kế',
    text: 'Chuyển nhu cầu thành concept, scope, architecture, roadmap và tiêu chí thành công rõ ràng.',
  },
  {
    label: 'Phát triển',
    text: 'Làm việc cùng team kỹ thuật để build, test, iterate và triển khai giải pháp vào môi trường thật.',
  },
  {
    label: 'Chuyển giao',
    text: 'Tài liệu hoá, đào tạo người dùng, bàn giao vận hành và tiếp tục cải tiến khi tổ chức thay đổi.',
  },
];

const caseChallenges = [
  {
    title: 'Ai thực sự có ảnh hưởng?',
    text: 'Chức danh cao không đồng nghĩa với khả năng thay đổi hành vi người khác — người có ảnh hưởng thật thường không xuất hiện trên sơ đồ tổ chức.',
  },
  {
    title: 'Thông tin di chuyển theo đường nào?',
    text: 'Hành vi lan truyền qua mạng lưới quan hệ thật, không theo đường báo cáo chính thức.',
  },
  {
    title: 'Điểm nghẽn nằm ở đâu?',
    text: 'Một số phòng ban gần như biệt lập — thông tin không chảy tới, cơ hội phối hợp bị bỏ lỡ.',
  },
  {
    title: 'Nên can thiệp ở đâu để tác động lớn nhất?',
    text: 'Thay vì triển khai đại trà, tổ chức cần tìm đúng điểm kích hoạt trong mạng lưới.',
  },
];

const caseApproach = [
  {
    label: 'Lập bản đồ mạng lưới thật',
    text: 'Khảo sát toàn bộ 300+ nhân viên văn phòng để đo hai luồng quan hệ cốt lõi: ai được hỏi xin lời khuyên về an ninh mạng, và ai được tin tưởng đủ để thay đổi hành vi.',
  },
  {
    label: 'Xác định Champion bằng thuật toán',
    text: 'Phân tích dữ liệu mạng lưới để tìm nhân viên hội tụ 3 đặc điểm: mật độ kết nối cao, thường xuyên được tìm đến, và kết nối với người có ảnh hưởng khác. Kết quả: 50 Champion được xác định trong hơn 300 người.',
  },
  {
    label: 'Triển khai và đo lường kết quả',
    text: 'Dẫn dắt sự thay đổi thông qua các Champion đã xác định, sau đó đo lại toàn bộ mạng lưới để xác nhận tác động bằng dữ liệu — không phải cảm nhận chủ quan.',
  },
];

const caseStats = [
  { label: 'Trao đổi 2 chiều — mạng lưới tư vấn an ninh mạng', value: '+256%' },
  { label: 'Trao đổi 2 chiều — mạng lưới hỗ trợ kỹ thuật', value: '+1.067%' },
  { label: 'Trao đổi 2 chiều — mạng lưới ảnh hưởng hành vi', value: '+100%' },
  { label: 'Phụ thuộc vào nhóm nhỏ cá nhân — tư vấn', value: '−44,5%' },
  { label: 'Phụ thuộc vào nhóm nhỏ cá nhân — hỗ trợ kỹ thuật', value: '−42,2%' },
  { label: 'Phụ thuộc vào nhóm nhỏ cá nhân — ảnh hưởng hành vi', value: '−31,6%' },
];

const influenceFactors = [
  ['Cùng phòng ban với người bị ảnh hưởng', 'Sự gần gũi trong công việc hằng ngày quan trọng hơn vị trí trên sơ đồ tổ chức.'],
  ['Trẻ tuổi hơn người bị ảnh hưởng', 'Tuổi trẻ không làm giảm ảnh hưởng — nằm ngoài kỳ vọng của chính ban lãnh đạo.'],
  ['Cấp bậc cao hơn người bị ảnh hưởng', 'Một khoảng cách vừa phải tạo uy tín; không cần vị trí lãnh đạo cấp cao.'],
  ['Thâm niên lâu hơn với tổ chức', 'Thâm niên tạo uy tín ngầm trong mắt đồng nghiệp.'],
  ['Được chủ động tìm đến xin lời khuyên (yếu tố mạnh nhất)', 'Không đo được qua KPI hay chức danh — nhưng là yếu tố dự đoán mạnh nhất.'],
];

const championArchetypes = [
  ['Expert (Chuyên gia)', 'Nguồn kiến thức đáng tin cậy nhất. Đồng nghiệp tìm đến không phải vì thân thiện hay tiện lợi — mà vì họ đúng.', heroImages.ai],
  ['Connector (Người kết nối)', 'Kết nối các nhóm vốn không tương tác với nhau. Đứng ở đường ranh của tổ chức, di chuyển thông tin và cơ hội qua các ranh giới.', heroImages.ona],
  ['Silo Buster (Người phá vỡ cô lập)', 'Phiên bản mạnh và chủ động hơn của Connector — chủ động phá vỡ một ranh giới cấu trúc cụ thể, thay vì tình cờ đứng giữa nó.', heroImages.software],
  ['Amplifier (Người lan toả)', 'Một khi họ áp dụng một hành vi hay tư duy mới, nó lan ra rõ rệt trong cả nhóm — nhờ nằm sâu trong một cụm kết nối dày đặc.', softwareCapabilities[2].image],
  ['Local Expert (Chuyên gia cục bộ)', 'Expert của riêng một nhóm hay lĩnh vực, không phải toàn tổ chức — được tin tưởng sâu sắc trong nhóm mình.', softwareCapabilities[1].image],
  ['Mentor (Người dẫn dắt)', 'Được định nghĩa bởi sự cho đi bất đối xứng — hỗ trợ, tư vấn nhiều hơn nhận lại, thường không giữ vai trò quản lý chính thức.', softwareCapabilities[3].image],
];

---

<BaseLayout
  title={title}
  description={description}
  lang="vi"
  canonicalUrl={canonicalUrl}
  jsonLd={netiqSchema}
>
  <div class="container consulting-page">
    <header class="consulting-hero">
      <div class="consulting-hero__copy">
        <p class="consulting-eyebrow">Tư vấn / Giải pháp</p>
        <h1>NetIQ giúp tổ chức nhìn thấy điều vô hình, rồi biến nó thành giải pháp có thể vận hành.</h1>
        <p class="consulting-hero__lead">
          Từ phân tích mạng lưới tổ chức (ONA), chiến lược AI, chuyển đổi số đến phát triển
          phần mềm theo nhu cầu, NetIQ kết nối tư vấn dựa trên dữ liệu với năng lực xây dựng
          giải pháp thật cho doanh nghiệp.
        </p>
        <div class="consulting-actions">
          <EmailLink class="btn btn--primary" label="Hợp tác cùng NetIQ" subject="Hop tac cung NetIQ" />
          <a class="btn btn--secondary" href={netiqWebsite} target="_blank" rel="noopener noreferrer">
            Tìm hiểu thêm về NetIQ
          </a>
        </div>
      </div>

      <div class="solution-board" aria-label="Các mảng tư vấn và giải pháp của NetIQ">
        <div class="solution-board__panel">
          <img src={heroImages.ai} alt="Chiến lược và triển khai AI" loading="eager" />
          <span>AI</span>
          <strong>Chiến lược · Triển khai · Champion</strong>
        </div>
        <div class="solution-board__panel solution-board__panel--network">
          <img src={heroImages.ona} alt="Phân tích mạng lưới tổ chức ONA" loading="lazy" />
          <span>ONA</span>
          <strong>Ảnh hưởng · Niềm tin · Tri thức</strong>
        </div>
        <div class="solution-board__panel solution-board__panel--accent">
          <img src={heroImages.software} alt="Phát triển phần mềm và nền tảng số" loading="lazy" />
          <span>Phần mềm</span>
          <strong>Nền tảng · Dữ liệu · Tự động hoá</strong>
        </div>
      </div>
    </header>

    <section class="consulting-section consulting-section--intro">
      <div>
        <p class="consulting-eyebrow">NetIQ làm gì</p>
        <h2>Tư vấn để hiểu hệ thống. Xây giải pháp để hệ thống thay đổi.</h2>
      </div>
      <div class="advisory-grid">
        {advisoryCards.map((card) => (
          <article class="advisory-card">
            <span>{card.tag}</span>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
            {card.href && <a class="advisory-card__link" href={card.href}>{card.linkLabel} →</a>}
          </article>
        ))}
      </div>
    </section>

    <section class="consulting-section consulting-section--split">
      <div>
        <p class="consulting-eyebrow">ONA consulting</p>
        <h2>Sơ đồ tổ chức chỉ là câu chuyện chính thức.</h2>
      </div>
      <div class="question-grid">
        {onaQuestions.map((question) => (
          <article class="question-card">
            <p>{question}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="consulting-section">
      <div class="section-header section-header--inline">
        <div>
          <p class="consulting-eyebrow">Phần mềm theo yêu cầu</p>
          <h2>Khi tư vấn cần đi xa hơn slide, NetIQ có team để xây.</h2>
        </div>
        <p>
          Dịch vụ phần mềm của NetIQ không bị giới hạn ở website, data platform hay data
          migration. Nếu khách hàng có một nhu cầu vận hành, dữ liệu hoặc nền tảng số cụ thể,
          NetIQ có thể cùng khách hàng tư vấn, thiết kế và phát triển giải pháp phù hợp.
        </p>
      </div>

      <div class="software-carousel" aria-label="Các năng lực phần mềm theo yêu cầu">
        {softwareCapabilities.map((item) => (
          <article class="software-card">
            <div class="software-card__visual">
              <img src={item.image} alt={item.title} loading="lazy" />
            </div>
            <div class="software-card__body">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="consulting-section delivery-section">
      <div class="section-header">
        <p class="consulting-eyebrow">Cách làm việc</p>
        <h2>Từ bài toán mơ hồ đến giải pháp có thể bàn giao.</h2>
      </div>
      <div class="delivery-grid">
        {deliverySteps.map((step, index) => (
          <article class="delivery-step">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.label}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section
      class="consulting-section case-study"
      aria-label="Case study: Từ mạng lưới vô hình đến kết quả đo được bằng con số"
      data-case-story
      tabindex="0"
    >
      <header class="case-study__toolbar">
        <p class="consulting-eyebrow">Case study</p>
        <p class="case-study__progress" aria-live="polite"><span data-case-current>01</span> / <span data-case-total>09</span></p>
      </header>

      <div class="case-study__viewport">
        <div class="case-study__panel active" data-case-panel data-label="Tổng quan">
          <header class="case-study__header">
            <h2 id="case-study-title">Từ mạng lưới vô hình đến kết quả đo được bằng con số.</h2>
            <p class="case-study__lead">
              Một nhà thầu xây dựng &amp; nội thất hàng đầu Việt Nam — hơn 300 nhân viên văn phòng, hơn 1.000
              công nhân kỹ thuật, 2 văn phòng, 3 nhà máy. Mục tiêu của ban lãnh đạo rất rõ: nâng nhận thức
              an ninh mạng trong toàn tổ chức. Vấn đề không phải ngân sách hay cam kết — mà là không ai biết
              nên nhắm vào ai, qua ai, hay bắt đầu từ đâu để tạo hiệu ứng lan toả rộng nhất.
            </p>
          </header>
        </div>

        <div class="case-study__panel case-study__block" data-case-panel data-label="Bài toán" hidden>
        <div class="section-header">
          <p class="consulting-eyebrow">Bài toán</p>
          <h3>Muốn thay đổi hành vi, trước hết phải nhìn thấy mạng lưới thật.</h3>
        </div>
        <div class="question-grid">
          {caseChallenges.map((item) => (
            <article class="question-card case-question-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>

        <div class="case-study__panel case-study__block" data-case-panel data-label="Cách tiếp cận" hidden>
        <div class="section-header">
          <p class="consulting-eyebrow">Cách tiếp cận</p>
          <h3>Ba bước từ dữ liệu quan hệ đến can thiệp có thể kiểm chứng.</h3>
        </div>
        <div class="delivery-grid case-approach-grid">
          {caseApproach.map((step, index) => (
            <article class="delivery-step">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{step.label}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
      </div>

        <div class="case-study__panel case-study__block" data-case-panel data-label="Kết quả" hidden>
        <div class="section-header">
          <p class="consulting-eyebrow">Kết quả đo lường</p>
          <h3>Mạng lưới trao đổi dày hơn, mức phụ thuộc vào một nhóm nhỏ giảm xuống.</h3>
        </div>
        <div class="case-stats" aria-label="Sáu kết quả định lượng của case study">
          {caseStats.map((stat) => (
            <article class="advisory-card case-stat">
              <strong>{stat.value}</strong>
              <p>{stat.label}</p>
            </article>
          ))}
        </div>
      </div>

        <div class="case-study__panel case-study__block case-network" data-case-panel data-label="Before / After" data-ba hidden>
        <div class="section-header">
          <p class="consulting-eyebrow">Mạng lưới thay đổi</p>
          <h3>So sánh cấu trúc quan hệ trước và sau can thiệp.</h3>
        </div>
        <div class="ba-toggle" role="group" aria-label="Chọn trạng thái mạng lưới">
          <button class="btn btn--primary ba-btn active" type="button" data-state="before" aria-pressed="true">
            Trước can thiệp
          </button>
          <button class="btn btn--secondary ba-btn" type="button" data-state="after" aria-pressed="false">
            Sau can thiệp
          </button>
        </div>
        <div class="ba-comparison-grid">
          <section class="ba-visual" aria-labelledby="network-column-label">
            <p class="ba-column-label" id="network-column-label">Network</p>
            <div class="ba-frame">
              <div class="ba-placeholder active" data-state="before" aria-hidden="true">
                <span>Network before</span>
                <strong>Thay bằng network-before.jpg</strong>
              </div>
              <div class="ba-placeholder" data-state="after" aria-hidden="true">
                <span>Network after</span>
                <strong>Thay bằng network-after.jpg</strong>
              </div>
              <img
                src="/images/tu-van/case-study/network-before.jpg"
                alt="Sơ đồ mạng lưới trước can thiệp"
                class="ba-img active"
                data-state="before"
                loading="lazy"
              />
              <img
                src="/images/tu-van/case-study/network-after.jpg"
                alt="Sơ đồ mạng lưới sau can thiệp"
                class="ba-img"
                data-state="after"
                loading="lazy"
              />
            </div>
          </section>

          <aside class="ba-interpretation" aria-labelledby="interpretation-column-label" aria-live="polite">
            <p class="ba-column-label" id="interpretation-column-label">Diễn giải</p>

            <div class="ba-reading active" data-state="before">
              <span class="ba-reading__state">Trước can thiệp</span>
              <h4>Thông tin tập trung — và dễ mắc kẹt.</h4>
              <p>
                Mạng lưới phụ thuộc nặng vào hai đầu mối IT. Những gì tổ chức biết về an ninh mạng phải đi qua
                một số rất ít người trước khi chạm tới phần còn lại.
              </p>
              <ul>
                <li><strong>Hai điểm nghẽn:</strong> khối lượng trao đổi dồn vào một nhóm nhỏ.</li>
                <li><strong>Các cụm biệt lập:</strong> nhiều phòng ban gần như không có cầu nối trực tiếp.</li>
                <li><strong>Rủi ro lan toả thấp:</strong> thông điệp dễ dừng lại trước khi trở thành hành vi.</li>
              </ul>
              <div class="ba-reading__takeaway">
                <span>Hàm ý</span>
                <p>Đào tạo đại trà chưa đủ; tổ chức cần kích hoạt đúng người ở đúng vị trí mạng lưới.</p>
              </div>
            </div>

            <div class="ba-reading" data-state="after" hidden>
              <span class="ba-reading__state">Sau can thiệp</span>
              <h4>Ảnh hưởng được phân phối rộng hơn.</h4>
              <p>
                Sau khi các Champion được kích hoạt, trao đổi không còn chỉ xoay quanh IT. Mỗi phòng ban bắt
                đầu hình thành năng lực hỗ trợ và ảnh hưởng ngay trong cụm của mình.
              </p>
              <ul>
                <li><strong>Nhiều trung tâm cục bộ:</strong> kiến thức hiện diện gần nơi công việc diễn ra.</li>
                <li><strong>Cầu nối rõ hơn:</strong> thông tin có thêm đường đi qua ranh giới phòng ban.</li>
                <li><strong>Ít phụ thuộc cá nhân:</strong> mạng lưới vẫn vận hành khi một đầu mối vắng mặt.</li>
              </ul>
              <div class="ba-reading__takeaway">
                <span>Hàm ý</span>
                <p>Champion biến thay đổi từ một chiến dịch tập trung thành năng lực phân tán của tổ chức.</p>
              </div>
            </div>
          </aside>
        </div>
      </div>

        <div class="case-study__panel" data-case-panel data-label="Kiểm chứng" hidden>
          <div class="verification-panel">
            <header class="verification-panel__header">
              <div>
                <p class="consulting-eyebrow">Kiểm chứng tác động</p>
                <h3>Sao biết chắc là do Champion?</h3>
              </div>
              <p>Không dừng ở tương quan. Phân tích chuỗi thời gian kiểm tra cơ chế thay đổi qua từng chu kỳ đo lường.</p>
            </header>

            <div class="verification-panel__body">
              <div class="verification-hypotheses">
                <p class="verification-label">Hai khả năng cần tách biệt</p>
                <article>
                  <span>A</span>
                  <div>
                    <h4>Champion chỉ kết nối với người vốn đã tốt.</h4>
                    <p>Nếu đúng, mạng lưới chỉ phản ánh quan hệ có sẵn — không tạo ra giá trị mới.</p>
                  </div>
                </article>
                <article class="is-supported">
                  <span>B</span>
                  <div>
                    <h4>Champion chủ động tạo ra thay đổi.</h4>
                    <p>Kiến thức và hành vi của người xung quanh tiến bộ dần theo thời gian.</p>
                  </div>
                </article>
              </div>

              <div class="verification-evidence">
                <p class="verification-label">Dữ liệu trả lời</p>
                <article>
                  <span>01</span>
                  <div><h4>Loại trừ selection bias</h4><p>Champion không ưu tiên kết nối với người vốn đã có nhận thức cao.</p></div>
                </article>
                <article>
                  <span>02</span>
                  <div><h4>Tác động vượt trội</h4><p>Khả năng chia sẻ kiến thức và tạo ảnh hưởng cao hơn rõ rệt so với nhân viên thông thường.</p></div>
                </article>
                <article>
                  <span>03</span>
                  <div><h4>Thay đổi có thể đo được</h4><p>Nhận thức quanh Champion tăng tích cực qua nhiều chu kỳ liên tiếp.</p></div>
                </article>
              </div>
            </div>

            <footer class="verification-verdict">
              <span>Kết luận</span>
              <strong>Tác động được chứng minh bằng dữ liệu định lượng — không phải đánh giá chủ quan.</strong>
            </footer>
          </div>
        </div>

        <div class="case-study__panel" data-case-panel data-label="Phương pháp" hidden>
          <div class="section-header">
            <p class="consulting-eyebrow">Phương pháp</p>
            <h3>Cách NetIQ lập bản đồ và xác định Champion.</h3>
          </div>
          <div class="method-content method-content--visible">
            <div class="method-story-grid">
              <article>
                <span>01 · Map</span>
                <h4>Công việc thực sự diễn ra thế nào?</h4>
                <p>ONA lập bản đồ ai được hỏi xin lời khuyên, ai hợp tác với ai và ai hỗ trợ ai — thay vì dựa vào sơ đồ tổ chức hay tự đánh giá năng lực.</p>
              </article>
              <article>
                <span>02 · Multiplex</span>
                <h4>Mỗi quan hệ là một lớp dữ liệu riêng.</h4>
                <p>Các lớp quan hệ được lập bản đồ và đối chiếu cùng lúc, không bị gộp thành một biểu đồ “ai biết ai” duy nhất.</p>
              </article>
              <article>
                <span>03 · Score</span>
                <h4>Champion được xác định từ hai nguồn bằng chứng.</h4>
                <p>Điều kiện hành vi được kết hợp với vị trí mạng lưới tính bằng thuật toán độc quyền của NetIQ.</p>
              </article>
            </div>
            <div class="method-table-wrap">
              <table class="method-table">
                <caption>Điều gì dự đoán khả năng ảnh hưởng?</caption>
                <thead>
                  <tr><th>Yếu tố</th><th>Vì sao quan trọng</th></tr>
                </thead>
                <tbody>
                  {influenceFactors.map(([factor, reason]) => (
                    <tr><th scope="row">{factor}</th><td>{reason}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div class="case-study__panel" data-case-panel data-label="Archetypes" hidden>
          <div class="section-header">
            <p class="consulting-eyebrow">Champion archetypes</p>
            <h3 id="archetype-title">Sáu vai trò tạo nên một mạng lưới thay đổi.</h3>
          </div>
          <div class="archetype-grid">
            {championArchetypes.map(([name, text, image]) => (
              <article class="advisory-card archetype-card">
                <img src={image} alt="" loading="lazy" aria-hidden="true" />
                <div class="archetype-card__body">
                  <h4>{name}</h4>
                  <p>{text}</p>
                </div>
              </article>
            ))}
          </div>
          <p class="archetype-note">
            Một chương trình Champion hiếm khi chỉ cần một kiểu người. Hai người có thể có số lượng kết nối
            giống hệt nhau nhưng đóng vai trò hoàn toàn khác nhau, tuỳ vào việc những kết nối đó nằm ở đâu và
            chảy theo hướng nào.
          </p>
        </div>

        <div class="case-study__panel case-summary" data-case-panel data-label="Summary" hidden>
          <div class="section-header">
            <p class="consulting-eyebrow">Summary</p>
            <h3>ONA biến một chương trình thay đổi đại trà thành can thiệp đúng người, đúng mạng lưới.</h3>
          </div>
          <div class="advisory-grid case-summary__grid">
            <article class="advisory-card">
              <span>01 · Nhìn thấy</span>
              <h4>Ảnh hưởng thật không nằm trên sơ đồ tổ chức.</h4>
              <p>ONA làm lộ ra đường đi của lời khuyên, niềm tin và khả năng thay đổi hành vi trong hơn 300 nhân viên văn phòng.</p>
            </article>
            <article class="advisory-card">
              <span>02 · Kích hoạt</span>
              <h4>50 Champion tạo thành hạ tầng lan toả.</h4>
              <p>Thuật toán chọn đúng những người vừa được tìm đến, vừa có kết nối dày và có khả năng nối tới các cụm ảnh hưởng khác.</p>
            </article>
            <article class="advisory-card">
              <span>03 · Đo lường</span>
              <h4>Trao đổi hai chiều tăng tới +1.067%.</h4>
              <p>Ba mạng lưới tư vấn, hỗ trợ kỹ thuật và ảnh hưởng hành vi đều trở nên dày hơn sau can thiệp.</p>
            </article>
            <article class="advisory-card">
              <span>04 · Bền vững</span>
              <h4>Mức phụ thuộc vào nhóm nhỏ giảm tới 44,5%.</h4>
              <p>Tri thức và hỗ trợ được phân tán rộng hơn, giúp tổ chức ít lệ thuộc vào một vài đầu mối trung tâm.</p>
            </article>
          </div>
          <aside class="case-callout case-summary__closing">
            <p class="consulting-eyebrow">Kết luận</p>
            <h3>Champion không chỉ được tìm thấy — tác động của họ được chứng minh.</h3>
            <p>Phân tích chuỗi thời gian xác nhận thay đổi nhận thức diễn ra quanh Champion qua nhiều chu kỳ đo lường, thay vì chỉ phản ánh những quan hệ vốn đã tồn tại từ trước.</p>
          </aside>
        </div>
      </div>

      <nav class="case-study__nav" aria-label="Điều hướng case study">
        <button class="btn btn--secondary case-nav-btn" type="button" data-case-prev disabled>← Quay lại</button>
        <span class="case-study__step-label" data-case-label>Tổng quan</span>
        <button class="btn btn--primary case-nav-btn" type="button" data-case-next>Tiếp theo →</button>
      </nav>
    </section>

    <section class="consulting-cta">
      <p class="consulting-eyebrow">Bắt đầu từ bài toán của bạn</p>
      <h2>Có thể bạn cần một bản đồ mạng lưới. Có thể bạn cần một nền tảng số. Thường thì bạn cần cả hai.</h2>
      <div class="consulting-actions">
        <EmailLink class="btn btn--primary" label="Hợp tác cùng NetIQ" subject="Hop tac cung NetIQ" />
        <a class="btn btn--secondary" href={netiqWebsite} target="_blank" rel="noopener noreferrer">
          Tìm hiểu thêm về NetIQ
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
