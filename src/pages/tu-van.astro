---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailLink from '../components/EmailLink.astro';
import { netiqSchema } from '../data/schema-organization';

const title = 'Tư vấn / Giải pháp';
const description =
  'NetIQ tư vấn ONA, chiến lược AI, chuyển đổi số và phát triển phần mềm theo yêu cầu cho nhu cầu thực tế của tổ chức.';
const canonicalUrl = '/tu-van';

const netiqWebsite = 'https://www.netiq.vn';

const heroImages = {
  ai: '/images/tu-van/hero-ai-strategy-720x430.jpg',
  ona: '/images/tu-van/hero-ona-network-720x900.jpg',
  software: '/images/tu-van/hero-software-solutions-720x430.jpg',
};

const advisoryCards = [
  {
    title: 'Tư vấn ONA',
    tag: 'Network intelligence',
    text: 'Phân tích mạng lưới tổ chức để nhìn thấy ảnh hưởng, niềm tin, dòng tri thức, điểm nghẽn và những người có thể dẫn dắt thay đổi.',
  },
  {
    title: 'Tư vấn AI & chuyển đổi số',
    tag: 'Strategy',
    text: 'Giúp lãnh đạo thiết kế lộ trình AI, chương trình AI champion, năng lực dữ liệu và cách tổ chức triển khai thay đổi có căn cứ.',
  },
  {
    title: 'Phát triển phần mềm theo yêu cầu',
    tag: 'Build',
    text: 'Tư vấn và phát triển phần mềm theo nhu cầu: từ digital platforms, data platforms, migration, automation đến các ứng dụng AI nội bộ.',
  },
];

const onaQuestions = [
  'Ai thật sự giữ ảnh hưởng trong tổ chức?',
  'Tri thức đang chảy đi đâu, và tắc ở đâu?',
  'Những lãnh đạo phi chính thức nào có thể đưa AI vào thực tế?',
  'Cấu trúc quan hệ nào đang thúc đẩy hoặc cản trở thay đổi?',
];

const softwareCapabilities = [
  {
    title: 'Nền tảng số',
    text: 'Nền tảng vận hành, cổng thông tin, portal thành viên, workflow nội bộ hoặc các hệ thống phục vụ khách hàng.',
    image: '/images/tu-van/software-digital-platforms-720x480.jpg',
  },
  {
    title: 'Nền tảng dữ liệu & chuyển đổi',
    text: 'Thiết kế cấu trúc dữ liệu, chuyển đổi dữ liệu, dashboard, reporting layer và các nền tảng hỗ trợ ra quyết định.',
    image: '/images/tu-van/software-data-platforms-720x480.jpg',
  },
  {
    title: 'Ứng dụng tích hợp AI',
    text: 'Ứng dụng AI cho tri thức nội bộ, tự động hoá nghiệp vụ, phân tích văn bản, chatbot hoặc copilot theo quy trình riêng.',
    image: '/images/tu-van/software-ai-applications-720x480.jpg',
  },
  {
    title: 'Giải pháp riêng theo yêu cầu',
    text: 'Nếu bài toán không nằm gọn trong một loại sản phẩm có sẵn, NetIQ có team để tư vấn, thiết kế và phát triển giải pháp phù hợp.',
    image: '/images/tu-van/software-custom-solutions-720x480.jpg',
  },
];

const deliverySteps = [
  {
    label: 'Khám phá',
    text: 'Hiểu bài toán, stakeholder, dữ liệu, constraint vận hành và quyết định kinh doanh cần hỗ trợ.',
  },
  {
    label: 'Thiết kế',
    text: 'Chuyển nhu cầu thành concept, scope, architecture, roadmap và tiêu chí thành công rõ ràng.',
  },
  {
    label: 'Phát triển',
    text: 'Làm việc cùng team kỹ thuật để build, test, iterate và triển khai giải pháp vào môi trường thật.',
  },
  {
    label: 'Chuyển giao',
    text: 'Tài liệu hoá, đào tạo người dùng, bàn giao vận hành và tiếp tục cải tiến khi tổ chức thay đổi.',
  },
];

---

<BaseLayout
  title={title}
  description={description}
  lang="vi"
  canonicalUrl={canonicalUrl}
  jsonLd={netiqSchema}
>
  <div class="container consulting-page">
    <header class="consulting-hero">
      <div class="consulting-hero__copy">
        <p class="consulting-eyebrow">Tư vấn / Giải pháp</p>
        <h1>NetIQ giúp tổ chức nhìn thấy điều vô hình, rồi biến nó thành giải pháp có thể vận hành.</h1>
        <p class="consulting-hero__lead">
          Từ phân tích mạng lưới tổ chức (ONA), chiến lược AI, chuyển đổi số đến phát triển
          phần mềm theo nhu cầu, NetIQ kết nối tư vấn dựa trên dữ liệu với năng lực xây dựng
          giải pháp thật cho doanh nghiệp.
        </p>
        <div class="consulting-actions">
          <EmailLink class="btn btn--primary" label="Hợp tác cùng NetIQ" subject="Hop tac cung NetIQ" />
          <a class="btn btn--secondary" href={netiqWebsite} target="_blank" rel="noopener noreferrer">
            Tìm hiểu thêm về NetIQ
          </a>
        </div>
      </div>

      <div class="solution-board" aria-label="Các mảng tư vấn và giải pháp của NetIQ">
        <div class="solution-board__panel">
          <img src={heroImages.ai} alt="Chiến lược và triển khai AI" loading="eager" />
          <span>AI</span>
          <strong>Chiến lược · Triển khai · Champion</strong>
        </div>
        <div class="solution-board__panel solution-board__panel--network">
          <img src={heroImages.ona} alt="Phân tích mạng lưới tổ chức ONA" loading="lazy" />
          <span>ONA</span>
          <strong>Ảnh hưởng · Niềm tin · Tri thức</strong>
        </div>
        <div class="solution-board__panel solution-board__panel--accent">
          <img src={heroImages.software} alt="Phát triển phần mềm và nền tảng số" loading="lazy" />
          <span>Phần mềm</span>
          <strong>Nền tảng · Dữ liệu · Tự động hoá</strong>
        </div>
      </div>
    </header>

    <section class="consulting-section consulting-section--intro">
      <div>
        <p class="consulting-eyebrow">NetIQ làm gì</p>
        <h2>Tư vấn để hiểu hệ thống. Xây giải pháp để hệ thống thay đổi.</h2>
      </div>
      <div class="advisory-grid">
        {advisoryCards.map((card) => (
          <article class="advisory-card">
            <span>{card.tag}</span>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="consulting-section consulting-section--split">
      <div>
        <p class="consulting-eyebrow">ONA consulting</p>
        <h2>Sơ đồ tổ chức chỉ là câu chuyện chính thức.</h2>
      </div>
      <div class="question-grid">
        {onaQuestions.map((question) => (
          <article class="question-card">
            <p>{question}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="consulting-section">
      <div class="section-header section-header--inline">
        <div>
          <p class="consulting-eyebrow">Phần mềm theo yêu cầu</p>
          <h2>Khi tư vấn cần đi xa hơn slide, NetIQ có team để xây.</h2>
        </div>
        <p>
          Dịch vụ phần mềm của NetIQ không bị giới hạn ở website, data platform hay data
          migration. Nếu khách hàng có một nhu cầu vận hành, dữ liệu hoặc nền tảng số cụ thể,
          NetIQ có thể cùng khách hàng tư vấn, thiết kế và phát triển giải pháp phù hợp.
        </p>
      </div>

      <div class="software-carousel" aria-label="Các năng lực phần mềm theo yêu cầu">
        {softwareCapabilities.map((item) => (
          <article class="software-card">
            <div class="software-card__visual">
              <img src={item.image} alt={item.title} loading="lazy" />
              <span>Ảnh minh hoạ</span>
            </div>
            <div class="software-card__body">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="consulting-section delivery-section">
      <div class="section-header">
        <p class="consulting-eyebrow">Cách làm việc</p>
        <h2>Từ bài toán mơ hồ đến giải pháp có thể bàn giao.</h2>
      </div>
      <div class="delivery-grid">
        {deliverySteps.map((step, index) => (
          <article class="delivery-step">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.label}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="consulting-cta">
      <p class="consulting-eyebrow">Bắt đầu từ bài toán của bạn</p>
      <h2>Có thể bạn cần một bản đồ mạng lưới. Có thể bạn cần một nền tảng số. Thường thì bạn cần cả hai.</h2>
      <div class="consulting-actions">
        <EmailLink class="btn btn--primary" label="Hợp tác cùng NetIQ" subject="Hop tac cung NetIQ" />
        <a class="btn btn--secondary" href={netiqWebsite} target="_blank" rel="noopener noreferrer">
          Tìm hiểu thêm về NetIQ
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
.consulting-page {
  display: grid;
  gap: 1rem;
}

.consulting-hero,
.consulting-section,
.consulting-cta {
  overflow: hidden;
  border: 1px solid rgb(255 255 255 / 0.72);
  border-radius: 28px;
  background:
    radial-gradient(circle at top right, rgb(185 137 68 / 0.13), transparent 30%),
    linear-gradient(180deg, rgb(255 255 255 / 0.88), rgb(255 255 255 / 0.7));
  box-shadow: var(--shadow-soft);
}

.consulting-hero {
  display: grid;
  gap: clamp(1.2rem, 3vw, 2rem);
  align-items: stretch;
  min-height: min(760px, calc(100vh - 8rem));
  padding: clamp(1.2rem, 3vw, 2rem);
  background:
    radial-gradient(circle at 88% 12%, rgb(185 137 68 / 0.24), transparent 28%),
    linear-gradient(135deg, rgb(74 22 33 / 0.96), rgb(116 43 57 / 0.9) 58%, rgb(185 137 68 / 0.72) 120%);
  color: #fff;
}

.consulting-hero__copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.consulting-eyebrow {
  margin-bottom: 0.7rem;
  color: var(--color-primary);
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.consulting-hero .consulting-eyebrow {
  color: var(--color-accent-light);
}

.consulting-hero h1 {
  max-width: 15ch;
  color: #fff;
  font-size: clamp(2.25rem, 5vw, 4.45rem);
  line-height: 0.98;
}

.consulting-hero__lead {
  max-width: 52rem;
  color: rgb(255 255 255 / 0.84);
  font-size: clamp(1.02rem, 1.65vw, 1.2rem);
  line-height: 1.68;
}

.consulting-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
  margin-top: 0.55rem;
}

.solution-board {
  display: grid;
  min-height: 410px;
  gap: 0.75rem;
  grid-template-columns: 1fr 0.8fr;
  grid-template-rows: 1fr 1fr;
}

.solution-board__panel {
  position: relative;
  overflow: hidden;
  display: grid;
  align-content: end;
  min-height: 12rem;
  padding: 1rem;
  border: 1px solid rgb(255 255 255 / 0.18);
  border-radius: 22px;
  background:
    radial-gradient(circle at 22% 16%, rgb(255 255 255 / 0.18), transparent 30%),
    linear-gradient(135deg, rgb(255 255 255 / 0.14), rgb(255 255 255 / 0.04));
  color: #fff;
}

.solution-board__panel img,
.software-card__visual img {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.solution-board__panel::after,
.software-card__visual::after {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(180deg, rgb(20 24 33 / 0.08), rgb(20 24 33 / 0.68));
  content: '';
  pointer-events: none;
}

.solution-board__panel::before {
  position: absolute;
  inset: 0.75rem;
  border: 1px dashed rgb(255 255 255 / 0.2);
  border-radius: 17px;
  content: '';
  pointer-events: none;
  z-index: 2;
}

.solution-board__panel--network {
  grid-row: 1 / -1;
}

.solution-board__panel--accent {
  background:
    radial-gradient(circle at 22% 16%, rgb(185 137 68 / 0.3), transparent 32%),
    linear-gradient(145deg, rgb(255 255 255 / 0.14), rgb(255 255 255 / 0.05));
}

.solution-board__panel span,
.solution-board__panel strong {
  position: relative;
  z-index: 3;
}

.solution-board__panel span {
  width: fit-content;
  margin-bottom: 0.35rem;
  color: var(--color-accent-light);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.solution-board__panel strong {
  max-width: 14rem;
  color: rgb(255 255 255 / 0.92);
  font-size: clamp(1.15rem, 2vw, 1.45rem);
  line-height: 1.12;
}

.consulting-section,
.consulting-cta {
  padding: clamp(1.15rem, 2.6vw, 1.8rem);
}

.consulting-section--intro,
.consulting-section--split {
  display: grid;
  gap: 1rem;
}

.consulting-section h2,
.consulting-cta h2 {
  max-width: 18ch;
  margin-bottom: 0;
  font-size: clamp(1.65rem, 3.2vw, 2.65rem);
}

.section-header {
  max-width: 54rem;
  margin-bottom: 1rem;
}

.section-header--inline {
  display: grid;
  gap: 1rem;
  max-width: none;
  align-items: end;
}

.section-header--inline p:last-child {
  max-width: 44rem;
  margin-bottom: 0;
  color: var(--color-text-secondary);
  line-height: 1.7;
}

.advisory-grid,
.question-grid,
.delivery-grid {
  display: grid;
  gap: 0.8rem;
}

.advisory-card,
.question-card,
.delivery-step {
  border: 1px solid rgb(20 24 33 / 0.1);
  border-radius: 20px;
  background: rgb(255 255 255 / 0.62);
  color: var(--color-text-primary);
}

.advisory-card,
.question-card,
.delivery-step {
  padding: 1rem;
}

.advisory-card span,
.delivery-step span {
  color: var(--color-primary);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.advisory-card h3,
.delivery-step h3 {
  margin: 0.5rem 0;
  font-size: clamp(1.16rem, 1.8vw, 1.45rem);
}

.advisory-card p,
.question-card p,
.delivery-step p {
  margin: 0;
  color: var(--color-text-secondary);
  line-height: 1.62;
}

.question-card {
  min-height: 8.5rem;
  display: grid;
  align-content: end;
  background:
    radial-gradient(circle at top left, rgb(62 86 119 / 0.08), transparent 34%),
    rgb(255 255 255 / 0.62);
}

.question-card p {
  color: var(--color-text-primary);
  font-size: clamp(1.08rem, 1.6vw, 1.26rem);
  font-weight: 650;
  line-height: 1.35;
}

.software-carousel {
  display: grid;
  grid-auto-columns: minmax(280px, 35vw);
  grid-auto-flow: column;
  gap: 0.85rem;
  overflow-x: auto;
  padding: 0.1rem 0 0.75rem;
  scroll-snap-type: x proximity;
}

.software-card {
  overflow: hidden;
  display: grid;
  border: 1px solid rgb(20 24 33 / 0.1);
  border-radius: 20px;
  background: rgb(255 255 255 / 0.62);
  scroll-snap-align: start;
}

.software-card__visual {
  position: relative;
  display: grid;
  min-height: 13rem;
  align-content: end;
  padding: 1rem;
  background:
    radial-gradient(circle at 22% 18%, rgb(116 43 57 / 0.16), transparent 30%),
    radial-gradient(circle at 84% 12%, rgb(185 137 68 / 0.18), transparent 26%),
    linear-gradient(135deg, rgb(20 24 33 / 0.05), rgb(255 255 255 / 0.7));
}

.software-card__visual::before {
  position: absolute;
  inset: 0.75rem;
  border: 1px dashed rgb(20 24 33 / 0.16);
  border-radius: 16px;
  content: '';
  z-index: 2;
}

.software-card__visual span {
  position: relative;
  z-index: 3;
  color: #fff;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.software-card__body {
  padding: 1rem;
}

.software-card h3 {
  margin-bottom: 0.55rem;
  font-size: clamp(1.28rem, 2vw, 1.6rem);
}

.software-card p {
  margin: 0;
  color: var(--color-text-secondary);
  line-height: 1.62;
}

.consulting-cta {
  display: grid;
  gap: 0.9rem;
  justify-items: start;
  background:
    radial-gradient(circle at top right, rgb(185 137 68 / 0.18), transparent 28%),
    linear-gradient(135deg, rgb(116 43 57 / 0.1), rgb(255 255 255 / 0.78));
}

@media (min-width: 820px) {
  .consulting-hero {
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.76fr);
  }

  .consulting-section--intro,
  .consulting-section--split {
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    align-items: center;
  }

  .advisory-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .question-grid,
  .delivery-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .section-header--inline {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }
}

@media (min-width: 1080px) {
  .delivery-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

@media (max-width: 620px) {
  .consulting-hero {
    min-height: auto;
  }

  .solution-board {
    min-height: auto;
    grid-template-columns: 1fr;
    grid-template-rows: none;
  }

  .solution-board__panel--network {
    grid-row: auto;
  }

  .software-carousel {
    grid-auto-columns: minmax(245px, 82vw);
  }
}
</style>
