---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Thưởng thức';
const description =
  'Ambrosia evening lounge is an intellectual social space for whisky, cocktails, conversation, and slower evenings from 6pm onward.';
const canonicalUrl = '/thuong-thuc/';

const loungeNotes = [
  'Whisky and cocktail-led evenings',
  'A relaxed setting after formal meetings and dinners',
  'Conversation-first atmosphere',
  'An intellectual social space with a slower rhythm',
];
---

<BaseLayout
  title={title}
  description={description}
  lang="vi"
  canonicalUrl={canonicalUrl}
>
  <div class="container lounge-page">
    <header class="lounge-hero">
      <div class="lounge-hero__copy">
        <p class="lounge-hero__eyebrow">Thưởng thức</p>
        <h1>An evening lounge for whisky, cocktails, and intelligent conversation.</h1>
        <p class="lounge-hero__lead">
          From 6pm onward, Ambrosia shifts into an open lounge: a quieter, richer space
          for people who want good drinks and conversations with texture.
        </p>
        <a class="btn btn--primary" href="/lien-he/">Ask about the lounge</a>
      </div>
      <div class="lounge-hero__visual" aria-label="Ambrosia lounge atmosphere">
        <div class="lounge-glass"></div>
      </div>
    </header>

    <section class="lounge-section lounge-section--split">
      <div>
        <p class="lounge-section__eyebrow">After 6pm</p>
        <h2>Less noise. Better drinks. Deeper conversations.</h2>
      </div>
      <div class="lounge-copy">
        <p>
          Thưởng thức is the Ambrosia evening mode: open, social, and refined. It is a
          lounge for people who want hospitality to feel thoughtful rather than loud.
        </p>
        <p>
          The concept pairs whisky, cocktails, and relaxed service with an intellectual
          atmosphere: a place to end the day with people, ideas, and taste.
        </p>
      </div>
    </section>

    <section class="lounge-section">
      <div class="lounge-section__intro">
        <p class="lounge-section__eyebrow">The mood</p>
        <h2>A social space with an editorial soul.</h2>
      </div>
      <div class="lounge-grid">
        {loungeNotes.map((note) => <article>{note}</article>)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
.lounge-page {
  display: grid;
  gap: 1.2rem;
}

.lounge-hero,
.lounge-section {
  overflow: hidden;
  padding: clamp(1.35rem, 3vw, 2.4rem);
  border: 1px solid rgb(255 255 255 / 0.74);
  border-radius: 28px;
  background:
    radial-gradient(circle at top right, rgb(185 137 68 / 0.12), transparent 28%),
    linear-gradient(180deg, rgb(255 255 255 / 0.86), rgb(255 255 255 / 0.72));
  box-shadow: var(--shadow-soft);
}

.lounge-hero {
  display: grid;
  min-height: 62vh;
  gap: 2rem;
  align-items: center;
  background:
    radial-gradient(circle at top right, rgb(185 137 68 / 0.22), transparent 30%),
    linear-gradient(145deg, #211b22, #3a1e2a 54%, #7d4e2b 130%);
  color: #fff;
}

.lounge-hero__eyebrow,
.lounge-section__eyebrow {
  margin-bottom: 0.7rem;
  color: var(--color-accent-light);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.lounge-section__eyebrow {
  color: var(--color-primary);
}

.lounge-hero h1 {
  max-width: 12ch;
  color: #fff;
  font-size: clamp(2.8rem, 7vw, 5.8rem);
  line-height: 0.96;
}

.lounge-hero__lead {
  max-width: 52rem;
  color: rgb(255 255 255 / 0.82);
  font-size: clamp(1.05rem, 1.9vw, 1.28rem);
  line-height: 1.68;
}

.lounge-hero__visual {
  position: relative;
  min-height: 360px;
  border-radius: 28px;
  background:
    radial-gradient(circle at 50% 20%, rgb(255 231 179 / 0.4), transparent 18%),
    linear-gradient(180deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.02));
  box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
}

.lounge-glass {
  position: absolute;
  top: 18%;
  left: 50%;
  width: 42%;
  max-width: 180px;
  aspect-ratio: 0.78;
  border: 2px solid rgb(255 255 255 / 0.52);
  border-top: 0;
  border-radius: 0 0 36px 36px;
  transform: translateX(-50%);
}

.lounge-glass::before {
  position: absolute;
  right: 12%;
  bottom: 14%;
  left: 12%;
  height: 42%;
  border-radius: 0 0 24px 24px;
  background: linear-gradient(180deg, #e2ac58, #9b5f2b);
  content: '';
}

.lounge-glass::after {
  position: absolute;
  right: 24%;
  bottom: -3.8rem;
  left: 24%;
  height: 3.8rem;
  border-bottom: 2px solid rgb(255 255 255 / 0.52);
  background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.36), transparent);
  content: '';
}

.lounge-section h2 {
  max-width: 14ch;
  margin-bottom: 0;
  font-size: clamp(1.8rem, 3.8vw, 3rem);
}

.lounge-section__intro {
  max-width: 56rem;
  margin-bottom: 1.2rem;
}

.lounge-section--split,
.lounge-grid {
  display: grid;
  gap: 1rem;
}

.lounge-copy p {
  color: var(--color-text-secondary);
  line-height: 1.72;
}

.lounge-grid article {
  padding: 1.15rem;
  border: 1px solid var(--color-border);
  border-radius: 20px;
  background: rgb(255 255 255 / 0.72);
  color: var(--color-text-secondary);
  font-weight: 700;
}

@media (min-width: 840px) {
  .lounge-hero,
  .lounge-section--split {
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.9fr);
  }

  .lounge-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}
</style>
