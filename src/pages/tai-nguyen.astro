---
import BaseLayout from '../layouts/BaseLayout.astro';
import { concepts } from '../data/resources';
import { getPublishedPosts, getPostUrl } from '../utils/posts';

const title = 'Tài nguyên';
const description = 'Khám phá khái niệm, bài viết, dự án ứng dụng và công bố khoa học về ONA, AI, an ninh thông tin và chuyển đổi số của Tiến sĩ Duy Đặng.';
const posts = (await getPublishedPosts()).slice(0, 3);
const sections = [
  { href: '#khai-niem', label: 'Khái niệm', note: 'Hiểu nền tảng' },
  { href: '#du-an', label: 'Dự án ứng dụng', note: 'Xem cách làm' },
  { href: '#bai-viet', label: 'Bài viết', note: 'Đọc góc nhìn' },
  { href: '#cong-bo', label: 'Công bố khoa học', note: 'Tìm bằng chứng' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: 'https://drduydangpham.com/tai-nguyen/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [
      ...concepts.map((item) => ({ name: item.title, url: item.href })),
      { name: 'Case study: ứng dụng ONA', url: '/tu-van/#case-study' },
      ...posts.map((post) => ({ name: post.data.title, url: getPostUrl(post) })),
      { name: 'Công bố khoa học', url: '/cong-bo-khoa-hoc/' },
    ].map((item, index) => ({
      '@type': 'ListItem', position: index + 1, name: item.name,
      url: new URL(item.url, 'https://drduydangpham.com').href,
    })),
  },
};
---

<BaseLayout title={title} description={description} lang="vi" canonicalUrl="/tai-nguyen/" jsonLd={jsonLd}>
  <div class="container resources-page">
    <header class="resources-hero">
      <div>
        <p class="eyebrow">Thư viện kiến thức &amp; thực hành</p>
        <h1>Tài nguyên</h1>
        <p class="lead">Từ hiểu một khái niệm đến nhìn thấy cách áp dụng.</p>
        <p class="intro">Khám phá những ý tưởng, bài viết và ví dụ thực tế từ công việc nghiên cứu, đào tạo và tư vấn của tôi về con người, công nghệ và tổ chức.</p>
      </div>
      <nav class="resource-directory" aria-label="Các nhóm tài nguyên">
        {sections.map((section, index) => (
          <a href={section.href}>
            <span class="directory-number">0{index + 1}</span>
            <span><strong>{section.label}</strong><small>{section.note}</small></span>
            <span aria-hidden="true">↘</span>
          </a>
        ))}
      </nav>
    </header>

    <section id="khai-niem" aria-labelledby="concepts-heading">
      <div class="section-heading">
        <div><p class="eyebrow">01 / Hiểu nền tảng</p><h2 id="concepts-heading">Khái niệm</h2></div>
        <a class="text-link" href="/khai-niem/">Xem tất cả khái niệm <span aria-hidden="true">↗</span></a>
      </div>
      <div class="concept-grid">
        {concepts.map((concept) => (
          <a class="resource-card" href={concept.href}>
            <span class="eyebrow">{concept.label}</span>
            <h3>{concept.title}</h3><p>{concept.description}</p>
            <span class="card-action">Tìm hiểu <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </section>

    <section id="du-an" aria-labelledby="projects-heading">
      <div class="section-heading">
        <div><p class="eyebrow">02 / Xem cách làm</p><h2 id="projects-heading">Dự án ứng dụng</h2></div>
        <p>Từ câu hỏi của tổ chức đến cách tiếp cận và kết quả thực tế.</p>
      </div>
      <article class="case-feature">
        <div class="case-feature__copy">
          <p class="eyebrow">Case study / ONA &amp; an ninh thông tin</p>
          <h3>Thay đổi hành vi qua mạng lưới con người.</h3>
          <p>Cách sử dụng phân tích mạng lưới tổ chức để nhận diện người có ảnh hưởng, thiết kế mạng lưới Champion và đo lường thay đổi trong một doanh nghiệp xây dựng &amp; nội thất tại Việt Nam.</p>
          <a class="btn btn--primary" href="/tu-van/#case-study">Khám phá case study <span aria-hidden="true">↗</span></a>
        </div>
        <div class="case-feature__outline" aria-label="Nội dung case study">
          <p><span>01</span> Bài toán của tổ chức</p>
          <p><span>02</span> Cách tiếp cận bằng ONA</p>
          <p><span>03</span> Kết quả &amp; bài học</p>
          <a class="text-link" href="/tu-van/">Tìm hiểu hoạt động tư vấn <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    </section>

    <section id="bai-viet" aria-labelledby="posts-heading">
      <div class="section-heading">
        <div><p class="eyebrow">03 / Đọc góc nhìn</p><h2 id="posts-heading">Bài viết &amp; góc nhìn</h2></div>
        <a class="text-link" href="/goc-nhin/">Xem tất cả bài viết <span aria-hidden="true">↗</span></a>
      </div>
      <div class="posts-list">
        {posts.map((post) => (
          <article class="post-row">
            <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('vi-VN')}</time>
            <div><h3><a href={getPostUrl(post)}>{post.data.title}</a></h3><p>{post.data.description}</p></div>
            <a class="text-link" href={getPostUrl(post)} aria-label={`Đọc bài: ${post.data.title}`}>Đọc bài <span aria-hidden="true">↗</span></a>
          </article>
        ))}
        {posts.length === 0 && <p>Các bài viết đang được chuẩn bị. Bạn có thể bắt đầu từ nhóm khái niệm phía trên.</p>}
      </div>
    </section>

    <section id="cong-bo" class="publications-panel" aria-labelledby="publications-heading">
      <div>
        <p class="eyebrow">04 / Tìm bằng chứng</p>
        <h2 id="publications-heading">Công bố khoa học</h2>
        <p>Các nghiên cứu về mạng lưới tổ chức, hành vi an ninh thông tin, AI và chuyển đổi số. Tra cứu danh mục bài báo và thông tin trích dẫn để đọc sâu hơn.</p>
      </div>
      <div class="publication-links">
        <a class="btn btn--primary" href="/cong-bo-khoa-hoc/">Tra cứu công bố <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/nghien-cuu/">Tìm hiểu hướng nghiên cứu <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .resources-page { display: grid; gap: clamp(2.5rem, 5vw, 4.5rem); }
  .resources-page section { scroll-margin-top: 8rem; }
  .eyebrow { margin: 0; color: var(--color-primary); font-size: .75rem; font-weight: 750; letter-spacing: .13em; text-transform: uppercase; }
  .resources-hero, .resource-card, .case-feature, .posts-list, .publications-panel { border: 1px solid rgb(255 255 255 / .75); border-radius: var(--radius-lg); background: linear-gradient(135deg, rgb(255 255 255 / .94), rgb(255 255 255 / .65)); box-shadow: var(--shadow-soft); }
  .resources-hero { display: grid; gap: 2rem; align-items: center; padding: clamp(1.4rem, 4vw, 3.5rem); background: radial-gradient(ellipse at top left, rgb(185 137 68 / .16), transparent 60%), linear-gradient(135deg, rgb(255 255 255 / .94), rgb(255 255 255 / .65)); }
  h1 { margin: 1.2rem 0; font-size: clamp(3.6rem, 8vw, 7.3rem); line-height: 1; letter-spacing: -.065em; }
  .lead { max-width: 24ch; margin: 0 0 1rem; font-size: clamp(1.5rem, 2.5vw, 2.25rem); line-height: 1.25; letter-spacing: -.025em; color: var(--color-text-primary); }
  .intro { max-width: 58ch; margin: 0; line-height: 1.8; color: var(--color-text-secondary); }
  .resource-directory { display: grid; gap: .4rem; }
  .resource-directory a { display: flex; gap: 1rem; align-items: center; padding: 1rem; border-bottom: 1px solid var(--color-border-subtle); color: var(--color-text-primary); border-radius: 12px; }
  .resource-directory a:hover { background: rgb(116 43 57 / .06); }
  .directory-number { font-family: var(--font-mono); font-size: .75rem; color: var(--color-primary); }
  .resource-directory strong, .resource-directory small { display: block; }
  .resource-directory strong { font-size: 1.1rem; }
  .resource-directory small { margin-top: .15rem; color: var(--color-text-secondary); }
  .resource-directory a > span:last-child { margin-left: auto; color: var(--color-primary); }
  .section-heading { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.2rem; }
  h2 { margin: .5rem 0 0; font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -.045em; line-height: 1.1; }
  .section-heading > p { max-width: 38ch; margin: 0; color: var(--color-text-secondary); }
  .text-link { display: inline-flex; gap: .6rem; align-items: center; width: fit-content; color: var(--color-primary); font-weight: 650; text-decoration: underline; text-underline-offset: .25em; }
  .concept-grid { display: grid; gap: 1rem; }
  .resource-card { display: flex; flex-direction: column; gap: 1rem; padding: clamp(1.25rem, 2.5vw, 2rem); color: var(--color-text-primary); }
  .resource-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lift); }
  .resource-card h3 { max-width: 18ch; margin: .6rem 0 0; font-size: clamp(1.5rem, 2.5vw, 2rem); line-height: 1.15; letter-spacing: -.035em; }
  .resource-card p, .case-feature p:not(.eyebrow), .post-row p, .publications-panel p:not(.eyebrow) { margin: 0; line-height: 1.75; color: var(--color-text-secondary); }
  .card-action { margin-top: auto; padding-top: .75rem; color: var(--color-primary); font-size: .9rem; font-weight: 650; }
  .card-action span { float: right; }
  .case-feature { display: grid; gap: 2rem; padding: clamp(1.4rem, 3.5vw, 3rem); background: radial-gradient(ellipse at bottom right, rgb(116 43 57 / .09), transparent 60%), rgb(255 255 255 / .8); }
  .case-feature__copy { display: grid; justify-items: start; gap: 1.2rem; }
  .case-feature h3 { max-width: 22ch; margin: 0; font-size: clamp(1.8rem, 3vw, 2.8rem); line-height: 1.1; letter-spacing: -.035em; }
  .case-feature__outline { display: grid; align-content: center; gap: 1.2rem; }
  .case-feature__outline p { padding-bottom: 1rem; border-bottom: 1px solid var(--color-border-subtle); }
  .case-feature__outline span { margin-right: .75rem; color: var(--color-primary); font-family: var(--font-mono); font-size: .8rem; }
  .posts-list { padding: clamp(1.25rem, 3vw, 2.5rem); }
  .post-row { display: grid; gap: 1rem; align-items: start; padding-block: 1.25rem; }
  .post-row + .post-row { border-top: 1px solid var(--color-border-subtle); }
  .post-row time { color: var(--color-text-muted); font-size: .85rem; }
  .post-row h3 { margin: 0 0 .6rem; font-size: 1.4rem; line-height: 1.3; }
  .post-row h3 a { color: var(--color-text-primary); }
  .post-row h3 a:hover { color: var(--color-primary); text-decoration: underline; }
  .publications-panel { display: grid; align-items: center; gap: 2rem; padding: clamp(1.4rem, 3.5vw, 3rem); }
  .publications-panel h2 { margin-bottom: 1rem; }
  .publication-links { display: grid; gap: 1rem; justify-items: start; }
  @media (min-width: 820px) {
    .resources-hero { grid-template-columns: 1.3fr 1fr; }
    .concept-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .case-feature { grid-template-columns: 1.4fr 1fr; }
    .publications-panel { grid-template-columns: 1.5fr 1fr; }
    .post-row { grid-template-columns: 7rem minmax(0, 1fr) auto; }
  }
  @media (prefers-reduced-motion: reduce) { .resource-card:hover { transform: none; } }
</style>
