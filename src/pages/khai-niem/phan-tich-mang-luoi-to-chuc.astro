---
import BaseLayout from '../../layouts/BaseLayout.astro';

const canonicalUrl = '/khai-niem/phan-tich-mang-luoi-to-chuc/';

const title = 'Phân tích mạng lưới tổ chức (ONA)';
const description =
  'Khám phá bản đồ Phân tích mạng lưới tổ chức tương tác và những câu hỏi ONA có thể trả lời cho lãnh đạo, nhân sự, vận hành và chuyển đổi số.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: 'Organisational Network Analysis',
  description:
    'Organisational Network Analysis maps the informal network of relationships, trust, and influence beneath an org chart to reveal how decisions, knowledge, and change actually move through an organisation.',
  url: `https://drduydangpham.com${canonicalUrl}`,
  sameAs: ['https://en.wikipedia.org/wiki/Organizational_network_analysis'],
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: 'ONA and AI Strategy Concepts',
    url: 'https://drduydangpham.com/khai-niem/',
  },
  author: {
    '@id': 'https://drduydangpham.com/#person',
  },
};

const roleQuestionSets = [
