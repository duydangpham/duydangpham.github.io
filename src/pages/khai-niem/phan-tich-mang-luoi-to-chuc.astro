const canonicalUrl = '/khai-niem/phan-tich-mang-luoi-to-chuc';

const title = 'Organisational Network Analysis';
const description =
  "Explore an interactive Organisational Network Analysis visualization and discover the questions ONA can answer for CEOs, CHROs, COOs, and transformation leaders. See what your org chart doesn't show.";

