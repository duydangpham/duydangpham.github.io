---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createConceptPageSchema } from '../../data/schema-concept-page';

const canonicalUrl = '/khai-niem/nguoi-tien-phong-ai/';

const title = 'AI Champion — Người tiên phong AI';
const description =
  'AI Champion là những cá nhân có vị trí mạng lưới, uy tín và sức ảnh hưởng phù hợp để thúc đẩy việc ứng dụng AI từ cấp cơ sở trong tổ chức.';

const archetypes = [
  {
    index: '01',
    name: 'Oracle',
    label: 'Điểm quy tụ tri thức',
    metric: 'Độ trung tâm trung gian cao trên nhiều lớp',
    description:
      'Người được nhiều đồng nghiệp tìm đến để xin lời khuyên, thông tin và sự xác nhận. Khi Oracle chia sẻ một cách dùng AI hiệu quả, thông điệp có độ tin cậy cao và lan nhanh.',
    role:
      'Đại sứ cốt lõi, người thử nghiệm sớm và điểm tham chiếu chuyên môn cho cộng đồng AI nội bộ.',
    tone: 'oracle',
  },
  {
    index: '02',
    name: 'Broker',
    label: 'Cầu nối xuyên biên giới',
    metric: 'Độ trung gian cao giữa các cộng đồng',
    description:
      'Người đứng giữa các phòng ban hoặc cộng đồng vốn ít trao đổi trực tiếp. Broker dịch chuyển use case, ngôn ngữ và kinh nghiệm AI qua ranh giới chuyên môn.',
    role:
      'Tác nhân chuyển giao tri thức liên chức năng, kết nối các nhóm và điều phối học tập xuyên phòng ban.',
    tone: 'broker',
  },
  {
    index: '03',
    name: 'Silo Buster',
    label: 'Người phá vỡ cô lập',
    metric: 'Ít trung tâm nội bộ, nhiều liên kết liên cộng đồng',
    description:
      'Không nhất thiết nổi bật trong nhóm của mình, nhưng duy trì những liên kết có ý nghĩa với nhiều cộng đồng. Họ giúp thực hành AI không dừng lại trong các nhóm tiên phong.',
    role:
      'Kết nối chặng cuối, đưa chương trình đến những vùng khó tiếp cận và bảo đảm không nhóm nào bị bỏ lại.',
    tone: 'silo',
  },
];

const programSteps = [
  {
    title: 'Chẩn đoán mạng lưới',
    text: 'Khảo sát multiplex ONA để lập bản đồ các lớp quan hệ có liên quan đến việc ứng dụng AI.',
  },
  {
    title: 'Nhận diện hình mẫu',
    text: 'Kết hợp độ trung tâm trung gian và cấu trúc cộng đồng để xác định Oracle, Broker và Silo Buster.',
  },
  {
    title: 'Thiết kế chương trình',
    text: 'Định nghĩa trách nhiệm, nội dung đào tạo, champion hours, cơ chế ghi nhận và chỉ số thành công.',
  },
  {
    title: 'Kích hoạt mạng lưới',
    text: 'Trang bị công cụ, tình huống ứng dụng, tài nguyên truyền thông và một cộng đồng thực hành nội bộ.',
  },
  {
    title: 'Đo lường thay đổi',
    text: 'Đo lại ONA sau 6–12 tháng để theo dõi độ phủ hỗ trợ AI, sự suy giảm silo và mức độ áp dụng.',
  },
];

const faqs = [
  {
    question: 'AI Champion là ai?',
    answer:
      'AI Champion là nhân viên có vị trí mạng lưới và vốn xã hội phù hợp để thúc đẩy đồng nghiệp ứng dụng AI một cách đáng tin cậy. Ảnh hưởng của họ đến từ quan hệ đã tồn tại, không chỉ từ chức danh.',
  },
  {
    question: 'Ba hình mẫu AI Champion khác nhau như thế nào?',
    answer:
      'Oracle là điểm quy tụ tri thức và niềm tin; Broker kết nối các cộng đồng khác nhau; Silo Buster đưa thực hành mới đến những nhóm dễ bị cô lập. Một chương trình hiệu quả cần phối hợp cả ba vai trò.',
  },
  {
    question: 'ONA nhận diện AI Champion bằng cách nào?',
    answer:
      'Dữ liệu khảo sát nhiều lớp được chuyển thành mạng lưới có hướng. Các chỉ số như độ trung tâm trung gian và phát hiện cộng đồng giúp chỉ ra ai đang kết nối tri thức, niềm tin và hỗ trợ AI trong cấu trúc thực tế.',
  },
  {
    question: 'Vì sao AI Champion hiệu quả hơn chỉ đạo từ trên xuống?',
    answer:
      'Con người thường thử và duy trì một hành vi mới khi thấy đồng nghiệp họ tin tưởng làm được và sẵn sàng hỗ trợ. AI Champion bổ sung lực kéo ngang hàng cho chiến lược và nguồn lực từ lãnh đạo.',
  },
  {
    question: 'Chương trình AI Champion được đo lường ra sao?',
    answer:
      'Ngoài chỉ số sử dụng công cụ, chương trình nên đo độ phủ của mạng lưới hỗ trợ, số nhóm được kết nối, sự phụ thuộc vào một vài cá nhân và thay đổi về niềm tin hoặc cộng tác sau 6–12 tháng.',
  },
];

const jsonLd = createConceptPageSchema({
  name: 'AI Champion — Người tiên phong AI',
  description,
  url: `https://drduydangpham.com${canonicalUrl}`,
  faqs,
});
---

<BaseLayout
  title={title}
  description={description}
  lang="vi"
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <div class="container champion-page">
    <header class="champion-hero">
      <div class="champion-hero__copy">
        <p class="champion-eyebrow">Khái niệm · AI adoption</p>
        <h1>AI không tự lan toả. Con người mới làm điều đó.</h1>
        <p class="champion-hero__lead">
          AI Champion là những cá nhân có vị trí mạng lưới, uy tín và sức ảnh hưởng phù hợp
          để đưa AI từ một chủ trương của lãnh đạo thành thực hành hằng ngày của đồng nghiệp.
        </p>
        <div class="champion-actions">
          <a class="btn btn--primary" href="#archetypes">Khám phá ba hình mẫu</a>
          <a class="btn btn--secondary" href="#program">Xem cách thiết kế chương trình</a>
        </div>
      </div>

      <div class="champion-signal" aria-label="Mô hình ảnh hưởng của AI Champion">
        <div class="champion-signal__orbit" aria-hidden="true">
          <span class="signal-node signal-node--core">AI</span>
          <span class="signal-node signal-node--one"></span>
          <span class="signal-node signal-node--two"></span>
          <span class="signal-node signal-node--three"></span>
          <span class="signal-node signal-node--four"></span>
          <span class="signal-node signal-node--five"></span>
        </div>
        <div class="champion-signal__legend">
          <span><i class="legend-dot legend-dot--primary"></i>Ảnh hưởng</span>
          <span><i class="legend-dot legend-dot--accent"></i>Niềm tin</span>
          <span><i class="legend-dot"></i>Hỗ trợ AI</span>
        </div>
        <p>Một champion đúng vị trí có thể kích hoạt cả một vùng mạng lưới.</p>
      </div>
    </header>

    <section class="champion-section champion-problem">
      <div>
        <p class="champion-eyebrow">Khoảng trống triển khai</p>
        <h2>Chỉ đạo tạo ra hướng đi. Niềm tin tạo ra chuyển động.</h2>
      </div>
      <div class="champion-problem__copy">
        <p>
          Nhiều tổ chức bắt đầu bằng chiến lược, công cụ và các khoá đào tạo. Nhưng tỷ lệ áp
          dụng vẫn chững lại vì nhân viên chưa thấy một người họ tin tưởng sử dụng AI hiệu quả
          trong đúng bối cảnh công việc của mình.
        </p>
        <p>
          ONA giúp tìm ra những người đã có sẵn quan hệ và uy tín để tạo ảnh hưởng ngang hàng.
          Chương trình AI Champion biến vốn xã hội đó thành một năng lực thay đổi có chủ đích.
        </p>
      </div>
    </section>

    <section id="archetypes" class="champion-section archetype-section">
      <div class="champion-section__heading">
        <div>
          <p class="champion-eyebrow">Ba hình mẫu bổ trợ nhau</p>
          <h2>Không phải ai cũng dẫn dắt AI theo cùng một cách.</h2>
        </div>
        <p>Mỗi hình mẫu giải quyết một điểm nghẽn khác nhau trong mạng lưới áp dụng AI.</p>
      </div>

      <div class="archetype-grid">
        {archetypes.map((item) => (
          <article class={`archetype-card archetype-card--${item.tone}`}>
            <div class="archetype-card__topline">
              <span>{item.index}</span>
              <span>{item.label}</span>
            </div>
            <h3>{item.name}</h3>
            <p class="archetype-card__metric">{item.metric}</p>
            <p>{item.description}</p>
            <div class="archetype-card__role">
              <strong>Vai trò trong chương trình</strong>
              <p>{item.role}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="program" class="champion-section program-section">
      <div class="champion-section__heading">
        <div>
          <p class="champion-eyebrow">Từ insight đến can thiệp</p>
          <h2>Thiết kế chương trình AI Champion trong năm bước.</h2>
        </div>
        <p>Không chọn champion theo cảm tính; bắt đầu từ mạng lưới và kết thúc bằng đo lường.</p>
      </div>

      <ol class="program-roadmap">
        {programSteps.map((step, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="champion-section faq-section">
      <div class="champion-section__heading">
        <div>
          <p class="champion-eyebrow">Câu hỏi thường gặp</p>
          <h2>Hiểu đúng trước khi kích hoạt mạng lưới.</h2>
        </div>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <nav class="champion-related" aria-label="Khái niệm liên quan">
      <div>
        <p class="champion-eyebrow">Đọc tiếp</p>
        <h2>Đặt AI Champion vào đúng bản đồ.</h2>
      </div>
      <div class="champion-related__grid">
          <a class="related-card" href="/khai-niem/phan-tich-mang-luoi-to-chuc/">
          <span>Khái niệm nền tảng</span>
          <strong>Phân tích mạng lưới tổ chức</strong>
          <p>Cách ONA làm rõ ảnh hưởng, niềm tin, silo và các cầu nối trong tổ chức.</p>
        </a>
          <a class="related-card" href="/khai-niem/do-trung-tam-trung-gian/">
          <span>Chỉ số mạng lưới</span>
          <strong>Độ trung tâm trung gian</strong>
          <p>Chỉ số giúp nhận diện những người kết nối các phần khác nhau của mạng lưới.</p>
        </a>
      </div>
    </nav>
  </div>
</BaseLayout>

<style>
.champion-page {
  display: grid;
  gap: 1rem;
}

.champion-hero,
.champion-section,
.champion-related {
  overflow: hidden;
  border: 1px solid rgb(255 255 255 / 0.74);
  border-radius: var(--radius-lg);
  background:
    radial-gradient(circle at top right, rgb(185 137 68 / 0.13), transparent 28%),
    linear-gradient(180deg, rgb(255 255 255 / 0.9), rgb(255 255 255 / 0.7));
  box-shadow: var(--shadow-soft);
}

.champion-hero {
  position: relative;
  display: grid;
  gap: clamp(1.5rem, 4vw, 3rem);
  min-height: min(700px, calc(100vh - 8rem));
  align-items: stretch;
  padding: clamp(1.3rem, 3.5vw, 3rem);
}

.champion-hero__copy {
  position: relative;
  z-index: 2;
  display: flex;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
}

.champion-eyebrow {
  margin: 0 0 0.7rem;
  color: var(--color-primary);
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.champion-hero h1 {
  max-width: 13ch;
  margin-bottom: 1.2rem;
  font-size: clamp(3rem, 6.6vw, 5.8rem);
  line-height: 0.94;
  letter-spacing: -0.055em;
}

.champion-hero__lead {
  max-width: 48rem;
  color: var(--color-text-secondary);
  font-size: clamp(1.06rem, 1.9vw, 1.32rem);
  line-height: 1.64;
}

.champion-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 0.6rem;
}

.champion-signal {
  position: relative;
  overflow: hidden;
  display: grid;
  min-height: 390px;
  align-content: end;
  padding: clamp(1rem, 2.5vw, 1.5rem);
  border: 1px solid rgb(116 43 57 / 0.12);
  border-radius: 28px;
  background:
    radial-gradient(circle at 50% 42%, rgb(185 137 68 / 0.18), transparent 18%),
    linear-gradient(145deg, rgb(255 255 255 / 0.94), rgb(244 235 232 / 0.86));
}

.champion-signal__orbit {
  position: absolute;
  top: 45%;
  left: 50%;
  width: min(78%, 340px);
  aspect-ratio: 1;
  transform: translate(-50%, -58%);
  border: 1px solid rgb(116 43 57 / 0.14);
  border-radius: 50%;
  box-shadow:
    0 0 0 2.8rem rgb(116 43 57 / 0.035),
    0 0 0 5.6rem rgb(185 137 68 / 0.035);
}

.champion-signal__orbit::before,
.champion-signal__orbit::after {
  position: absolute;
  background: rgb(116 43 57 / 0.16);
  content: '';
}

.champion-signal__orbit::before {
  top: 50%;
  right: 7%;
  left: 7%;
  height: 1px;
}

.champion-signal__orbit::after {
  top: 7%;
  bottom: 7%;
  left: 50%;
  width: 1px;
}

.signal-node {
  position: absolute;
  z-index: 2;
  width: 1rem;
  height: 1rem;
  border: 3px solid rgb(255 255 255 / 0.86);
  border-radius: 50%;
  background: var(--color-primary);
  box-shadow: 0 8px 20px rgb(116 43 57 / 0.28);
}

.signal-node--core {
  top: 50%;
  left: 50%;
  display: grid;
  width: 4.7rem;
  height: 4.7rem;
  transform: translate(-50%, -50%);
  place-items: center;
  background: linear-gradient(135deg, var(--color-primary), #93475a);
  color: #fff;
  font-weight: 800;
}

.signal-node--one { top: 2%; left: 47%; background: var(--color-accent); }
.signal-node--two { top: 24%; right: 4%; }
.signal-node--three { right: 14%; bottom: 8%; background: var(--color-accent); }
.signal-node--four { bottom: 2%; left: 32%; }
.signal-node--five { top: 30%; left: 2%; background: #83909f; }

.champion-signal__legend {
  position: relative;
  z-index: 3;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 0.9rem;
  margin-bottom: 0.55rem;
}

.champion-signal__legend span {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  color: var(--color-text-muted);
  font-size: 0.74rem;
  font-weight: 700;
}

.legend-dot {
  width: 0.48rem;
  height: 0.48rem;
  border-radius: 50%;
  background: #83909f;
}

.legend-dot--primary { background: var(--color-primary); }
.legend-dot--accent { background: var(--color-accent); }

.champion-signal > p {
  position: relative;
  z-index: 3;
  max-width: 30ch;
  margin: 0;
  color: var(--color-text-secondary);
  font-size: 0.9rem;
  font-weight: 650;
}

.champion-section,
.champion-related {
  padding: clamp(1.3rem, 3vw, 2.3rem);
}

.champion-problem,
.champion-section__heading,
.champion-related {
  display: grid;
  gap: 1rem clamp(2rem, 5vw, 5rem);
}

.champion-section h2,
.champion-related h2 {
  max-width: 18ch;
  margin: 0;
  font-size: clamp(1.8rem, 3.5vw, 3rem);
}

.champion-problem__copy,
.champion-section__heading > p {
  max-width: 45rem;
  color: var(--color-text-secondary);
  line-height: 1.75;
}

.champion-problem__copy p:last-child,
.champion-section__heading > p {
  margin-bottom: 0;
}

.champion-section__heading {
  align-items: end;
  margin-bottom: clamp(1.2rem, 3vw, 2rem);
}

.archetype-grid {
  display: grid;
  gap: 0.9rem;
}

.archetype-card {
  position: relative;
  overflow: hidden;
  display: flex;
  min-height: 100%;
  flex-direction: column;
  padding: clamp(1.15rem, 2.3vw, 1.6rem);
  border: 1px solid var(--color-border);
  border-top: 4px solid var(--color-primary);
  border-radius: var(--radius-md);
  background: rgb(255 255 255 / 0.82);
  box-shadow: var(--shadow-soft);
}

.archetype-card--broker { border-top-color: var(--color-accent); }
.archetype-card--silo { border-top-color: #83909f; }

.archetype-card__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: clamp(1.5rem, 4vw, 3rem);
  color: var(--color-text-muted);
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.archetype-card h3 {
  margin-bottom: 0.3rem;
  font-size: clamp(2rem, 4vw, 3rem);
}

.archetype-card__metric {
  min-height: 3rem;
  color: var(--color-primary) !important;
  font-family: var(--font-serif);
  font-style: italic;
}

.archetype-card > p,
.archetype-card__role p {
  color: var(--color-text-secondary);
  line-height: 1.7;
}

.archetype-card__role {
  margin-top: auto;
  padding-top: 1rem;
  border-top: 1px solid var(--color-border);
}

.archetype-card__role strong {
  display: block;
  margin-bottom: 0.35rem;
  color: var(--color-text-primary);
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.archetype-card__role p { margin: 0; font-size: 0.92rem; }

.program-roadmap {
  display: grid;
  gap: 0;
  margin: 0;
  padding: 0;
  list-style: none;
}

.program-roadmap li {
  display: grid;
  gap: 1rem;
  grid-template-columns: 2.5rem minmax(0, 1fr);
  padding: 1.2rem 0;
  border-top: 1px solid var(--color-border);
}

.program-roadmap li > span {
  color: var(--color-accent-dark);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 800;
}

.program-roadmap h3 {
  margin-bottom: 0.35rem;
  font-size: clamp(1.15rem, 2vw, 1.4rem);
}

.program-roadmap p {
  max-width: 52rem;
  margin: 0;
  color: var(--color-text-secondary);
  line-height: 1.7;
}

.faq-list {
  display: grid;
  gap: 0.65rem;
}

.faq-item {
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: rgb(255 255 255 / 0.76);
}

.faq-item summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1rem 1.2rem;
  color: var(--color-text-primary);
  font-weight: 700;
  cursor: pointer;
  list-style: none;
}

.faq-item summary::-webkit-details-marker { display: none; }
.faq-item summary::after { color: var(--color-primary); font-size: 1.35rem; content: '+'; }
.faq-item[open] summary::after { content: '−'; }

.faq-item p {
  max-width: 65rem;
  margin: 0;
  padding: 0 1.2rem 1.2rem;
