---
import { homeSchema } from '../data/schema-home';
import BaseLayout from '../layouts/BaseLayout.astro';
import { hasProfilePortrait, profilePortraitSrc } from '../utils/portrait';

const title = 'Trang chủ';
const description =
  'Tiến sĩ Duy Đặng kết nối đào tạo, chia sẻ, tư vấn, giải pháp, Ambrosia và nghiên cứu ứng dụng.';
const canonicalUrl = '/';

const pillars = [
  {
    eyebrow: 'Đào tạo / Chia sẻ',
    summary:
      'Giảng đường, buổi nói chuyện công chúng, chương trình đào tạo doanh nghiệp — cùng một cách tiếp cận: hiểu sâu trước, hành động sau.',
    href: '/dao-tao',
    cta: 'Vào lớp học',
    tone: 'scholar',
  },
  {
    eyebrow: 'Tư vấn / Giải pháp',
    summary:
      'NetIQ giúp lãnh đạo nhìn thấy mạng lưới vô hình trong tổ chức — và biến nó thành chiến lược AI, quy trình, phần mềm.',
    href: '/tu-van',
    cta: 'Hợp tác cùng NetIQ',
    tone: 'network',
  },
  {
    eyebrow: 'Sự kiện / Thưởng thức',
    summary:
      'Những cuộc gặp trang trọng ban ngày. Sau 6 giờ tối, nhịp chậm lại cho rượu ngon và trò chuyện sâu.',
    href: '/su-kien',
    cta: 'Ghé Ambrosia',
    tone: 'venue',
  },
  {
    eyebrow: 'Nghiên cứu',
    summary:
      'Công bố học thuật, nghiên cứu thị trường, phân tích dữ liệu — tôi biến câu hỏi phức tạp thành hiểu biết dùng được.',
    href: '/nghien-cuu',
    cta: 'Đọc nghiên cứu',
    tone: 'research',
  },
];

const supportingLinks = [
  {
    label: 'Định hướng nghiên cứu',
    href: '/nghien-cuu',
    kicker: 'Nền tảng học thuật',
    text: 'Câu hỏi tôi theo đuổi: hệ thống thông tin, mạng lưới tổ chức, AI, chuyển đổi số.',
  },
  {
    label: 'Công bố khoa học',
    href: '/cong-bo-khoa-hoc',
    kicker: 'Công trình nghiên cứu',
    text: 'Những gì tôi viết ra, được giới học thuật đọc và phản biện.',
  },
];

const ecosystemTiles = [
  {
    title: 'Tri thức được chia sẻ',
    text: 'Lớp học, seminar, và các chương trình đào tạo tạo ra một ngôn ngữ chung — để người tham dự nhìn vấn đề rõ hơn.',
    image: '/images/home/ecosystem-training-720x480.jpg',
    alt: 'Một buổi chia sẻ và đào tạo về AI',
    tone: 'scholar',
  },
  {
    title: 'Vấn đề được biến thành giải pháp',
    text: 'Tư vấn và phần mềm giúp tổ chức chuyển insight thành quyết định, quy trình, và nền tảng vận hành.',
    image: '/images/home/ecosystem-consulting-720x480.jpg',
    alt: 'Một chương trình tư vấn và chuyển đổi số',
    tone: 'network',
  },
  {
    title: 'Những cuộc gặp có không gian',
    text: 'Ambrosia là phần vật lý của hệ sinh thái — nơi những cuộc trò chuyện quan trọng có một căn phòng xứng đáng.',
    image: '/images/home/ecosystem-ambrosia-720x480.jpg',
    alt: 'Không gian Ambrosia cho những cuộc gặp trang trọng',
    tone: 'venue',
  },
  {
    title: 'Câu hỏi quay lại thành nghiên cứu',
    text: 'Những gì quan sát được trong lớp học, tổ chức, và đời sống trở thành câu hỏi mới — để kiểm chứng bằng nghiên cứu.',
    image: '/images/home/ecosystem-research-720x480.jpg',
    alt: 'Các hướng nghiên cứu về hệ thống thông tin và tổ chức',
    tone: 'research',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  lang="vi"
  canonicalUrl={canonicalUrl}
  jsonLd={homeSchema}
>
  <section class="home-hero">
    <div class="container home-hero__inner">
      <div class="home-hero__content">
        <h1>Mỗi cánh cửa dẫn tới một câu chuyện. Đây là nơi những câu chuyện của tôi bắt đầu.</h1>
        <p class="home-hero__lead">
          <span>Tôi chia sẻ kiến thức.</span>
          <span>Tôi tư vấn và xây dựng giải pháp.</span>
          <span>Tôi mở một không gian để gặp gỡ.</span>
          <span>Tôi biến câu hỏi đời thực thành nghiên cứu.</span>
          <span>Bốn việc khác nhau, cùng một niềm tin: hiểu nhau hơn để quyết định tốt hơn.</span>
        </p>
        <div class="home-hero__actions">
          <a class="btn btn--primary" href="/lien-he">Bắt đầu câu chuyện</a>
          <a class="btn btn--secondary" href="/gioi-thieu">Về Tiến sĩ Duy Đặng</a>
        </div>

        <div class="pillar-grid pillar-grid--hero" id="pillars" aria-label="Four business pillars">
          {pillars.map((pillar) => (
            <a class={`pillar-card pillar-card--${pillar.tone}`} href={pillar.href}>
              <h3>{pillar.eyebrow}</h3>
              <p>{pillar.summary}</p>
              <span class="pillar-card__cta">{pillar.cta}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="home-hero__media">
        {hasProfilePortrait && profilePortraitSrc ? (
          <img
            class="home-hero__portrait"
            src={profilePortraitSrc}
            alt="Portrait of Dr. Duy Dang-Pham"
            width="560"
            height="700"
            loading="eager"
          />
        ) : (
          <div class="home-hero__portrait-fallback" aria-hidden="true">DD</div>
        )}
      </div>
    </div>
  </section>

  <section class="home-ecosystem">
    <div class="container home-ecosystem__inner">
      <div class="home-ecosystem__copy">
        <p class="home-eyebrow">Một hệ sinh thái</p>
        <h2>Bốn cánh cửa, cùng một cách nhìn con người.</h2>
        <p>
          Đào tạo, tư vấn, Ambrosia, và nghiên cứu không phải bốn việc tách rời —
          chúng xoay quanh một niềm tin: khi con người hiểu nhau hơn, họ học sâu hơn,
          quyết định sáng hơn, gặp nhau tử tế hơn, và đặt ra những câu hỏi tốt hơn.
        </p>
      </div>

      <div class="ecosystem-stories" aria-label="Homepage ecosystem visual stories">
        {ecosystemTiles.map((item, index) => (
          <article
            class:list={[
              'ecosystem-story',
              `ecosystem-story--${item.tone}`,
              index % 2 === 1 && 'ecosystem-story--reverse',
            ]}
          >
            <div class="ecosystem-story__image">
              {item.image ? (
                <img src={item.image} alt={item.alt} loading="lazy" />
              ) : (
                <div class="ecosystem-story__placeholder" aria-hidden="true">
                  <span>Ambrosia</span>
                </div>
              )}
            </div>
            <div class="ecosystem-story__body">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="ecosystem-loop">Và vòng lặp lại bắt đầu.</p>
    </div>
  </section>

  <section class="home-context">
    <div class="container home-context__inner">
      <div class="home-context__intro">
        <p class="home-eyebrow">Nền tảng nghiên cứu</p>
        <h2>Nghiên cứu, mang ra khỏi trang giấy.</h2>
        <p>
          Tôi nghiên cứu cách con người và công nghệ kết nối trong tổ chức. Câu hỏi đó
          không nằm yên trong tạp chí khoa học — nó quay lại lớp học, bàn tư vấn, và cả
          Ambrosia.
        </p>
      </div>

      <div class="support-grid" aria-label="Supporting site areas">
        {supportingLinks.map((item, index) => (
          <a class="support-card" href={item.href}>
            <span class="support-card__index">{String(index + 1).padStart(2, '0')}</span>
            <span class="support-card__kicker">{item.kicker}</span>
            <strong>{item.label}</strong>
            <p>{item.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.home-hero {
  padding-block: 0.5rem 0.7rem;
}

.home-hero__inner {
  display: grid;
  gap: clamp(1.1rem, 3vw, 2rem);
  align-items: start;
}

.home-hero__media {
  position: relative;
  overflow: hidden;
  min-height: min(105vw, 560px);
  border-radius: 28px;
  background:
    linear-gradient(180deg, rgb(41 35 35 / 0.02), rgb(41 35 35 / 0.12)),
    var(--color-background-tertiary);
  box-shadow: var(--shadow-card);
}

.home-hero__media::after {
  position: absolute;
  inset: auto 1rem 1rem 1rem;
  height: 34%;
  border-radius: 24px;
  background: linear-gradient(180deg, transparent, rgb(20 24 33 / 0.54));
  content: '';
  pointer-events: none;
}

.home-hero__portrait,
.home-hero__portrait-fallback {
  width: 100%;
  height: 100%;
  min-height: inherit;
}

.home-hero__portrait {
  object-fit: cover;
  object-position: center top;
}

.home-hero__portrait-fallback {
  display: grid;
  place-items: center;
  color: var(--color-primary);
  font-size: clamp(4rem, 18vw, 8rem);
  font-weight: 800;
  letter-spacing: -0.08em;
}

.home-hero__content {
  display: flex;
  min-width: 0;
  flex-direction: column;
  justify-content: start;
  padding: clamp(0.25rem, 2vw, 0.8rem) 0;
}

.home-hero h1 {
  max-width: 100%;
  margin-bottom: 0.85rem;
  font-size: clamp(2.15rem, 4.15vw, 3.85rem);
  line-height: 1.02;
}

.home-hero__lead {
  max-width: min(100%, 56rem);
  margin-bottom: 0.85rem;
  color: #3f4b5d;
  font-size: clamp(1rem, 1.55vw, 1.15rem);
  font-weight: 520;
  line-height: 1.55;
}

.home-hero__lead span {
  display: block;
}

.home-hero__lead span:last-child {
  margin-top: 0.45rem;
  color: var(--color-text-primary);
  font-weight: 650;
}

.home-hero__actions {
  order: 4;
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
  margin-top: 0.85rem;
  margin-bottom: 0;
}

.pillar-grid {
  display: grid;
  gap: 0.8rem;
}

.pillar-grid--hero {
  order: 3;
}

.pillar-card {
  position: relative;
  overflow: hidden;
  display: grid;
  grid-template-rows: auto 1fr auto;
  gap: 0;
  min-height: 12.6rem;
  align-content: stretch;
  padding: clamp(1.1rem, 2.5vw, 1.55rem);
  border: 1px solid rgb(255 255 255 / 0.68);
  border-radius: 26px;
  background:
    radial-gradient(circle at top right, rgb(185 137 68 / 0.16), transparent 32%),
    linear-gradient(180deg, rgb(255 255 255 / 0.9), rgb(255 255 255 / 0.7));
  box-shadow: var(--shadow-soft);
  color: var(--color-text-primary);
}

.pillar-card::before {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, transparent 0%, rgb(20 24 33 / 0.05) 100%),
    radial-gradient(circle at 20% 16%, var(--pillar-glow), transparent 34%);
  content: '';
  pointer-events: none;
}

.pillar-card > * {
  position: relative;
  z-index: 1;
}

.pillar-card--scholar { --pillar-glow: rgb(116 43 57 / 0.2); }
.pillar-card--network { --pillar-glow: rgb(62 86 119 / 0.18); }
.pillar-card--venue { --pillar-glow: rgb(185 137 68 / 0.22); }
.pillar-card--lounge { --pillar-glow: rgb(41 35 45 / 0.18); }
.pillar-card--research { --pillar-glow: rgb(116 43 57 / 0.18); }

.pillar-card:hover {
  color: var(--color-text-primary);
  transform: translateY(-3px);
  box-shadow: var(--shadow-lift);
}

.pillar-card h3 {
  max-width: 18ch;
  margin-bottom: 0.58rem;
  font-size: clamp(1.7rem, 3vw, 2.35rem);
  line-height: 1.05;
}

.pillar-card p {
  max-width: 32rem;
  margin-bottom: 0.92rem;
  color: var(--color-text-secondary);
  font-size: 0.9rem;
  line-height: 1.55;
}

.pillar-card__cta {
  align-self: end;
  width: fit-content;
  color: var(--color-primary-dark);
  font-size: 0.92rem;
  font-weight: 800;
  text-decoration: underline;
  text-decoration-thickness: 0.08em;
  text-underline-offset: 0.2em;
}

.home-ecosystem {
  padding-block: 0.35rem 0.75rem;
}

.home-ecosystem__inner {
  display: grid;
  gap: 0.9rem;
  padding: clamp(1rem, 2.3vw, 1.45rem);
  border: 1px solid rgb(255 255 255 / 0.72);
  border-radius: 28px;
  background:
    radial-gradient(circle at top left, rgb(116 43 57 / 0.1), transparent 24%),
    radial-gradient(circle at bottom right, rgb(185 137 68 / 0.12), transparent 28%),
    linear-gradient(180deg, rgb(255 255 255 / 0.86), rgb(255 255 255 / 0.68));
  box-shadow: var(--shadow-soft);
}

.home-ecosystem__copy {
  position: relative;
  overflow: hidden;
  padding: clamp(1rem, 2.4vw, 1.6rem);
  border: 1px solid rgb(255 255 255 / 0.72);
  border-radius: 22px;
  background:
    radial-gradient(circle at top right, rgb(185 137 68 / 0.16), transparent 24%),
    linear-gradient(135deg, rgb(255 255 255 / 0.82), rgb(255 255 255 / 0.58));
}

.home-eyebrow {
  margin-bottom: 0.55rem;
  color: var(--color-primary);
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.home-ecosystem h2 {
  max-width: 100%;
  margin-bottom: 0.65rem;
  font-size: clamp(2rem, 3.9vw, 3.55rem);
  line-height: 1;
}

.home-ecosystem__copy p:last-child {
  max-width: 68rem;
  margin-bottom: 0;
  color: var(--color-text-secondary);
  font-size: clamp(1rem, 1.4vw, 1.14rem);
  line-height: 1.56;
}

.ecosystem-stories {
  display: grid;
  gap: 0.72rem;
}

.ecosystem-story {
  overflow: hidden;
  display: grid;
  gap: 0;
  border: 1px solid rgb(20 24 33 / 0.09);
  border-radius: 18px;
  background:
    linear-gradient(135deg, rgb(255 255 255 / 0.76), rgb(255 255 255 / 0.56)),
    radial-gradient(circle at 15% 20%, var(--story-glow), transparent 34%);
  box-shadow: 0 14px 34px rgb(15 23 42 / 0.06);
}

.ecosystem-story__image {
  position: relative;
  overflow: hidden;
  height: 10.5rem;
  min-height: 0;
  background: var(--story-bg);
}

.ecosystem-story__image::after {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, transparent 52%, rgb(20 24 33 / 0.28)),
    radial-gradient(circle at 18% 20%, var(--story-glow), transparent 38%);
  content: '';
  pointer-events: none;
}

.ecosystem-story__image img,
.ecosystem-story__placeholder {
  width: 100%;
  height: 100%;
}

.ecosystem-story__image img {
  display: block;
  object-fit: cover;
  transition: transform 420ms ease;
}

.ecosystem-story:hover .ecosystem-story__image img {
  transform: scale(1.04);
}

.ecosystem-story__placeholder {
  display: grid;
  place-items: center;
  background:
    radial-gradient(circle at 20% 18%, var(--story-glow), transparent 34%),
    linear-gradient(135deg, rgb(54 42 35 / 0.96), rgb(19 35 32 / 0.94));
}

.ecosystem-story__placeholder span {
  color: rgb(255 255 255 / 0.78);
  font-family: var(--font-serif);
  font-size: clamp(1.8rem, 4vw, 2.6rem);
  font-style: italic;
}

.ecosystem-story__body {
  display: grid;
  gap: 0.38rem;
  align-content: center;
  padding: clamp(0.9rem, 1.8vw, 1.15rem);
}

.ecosystem-story__body span {
  color: var(--color-primary);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.ecosystem-story h3 {
  margin: 0;
  font-size: clamp(1.08rem, 1.6vw, 1.36rem);
  line-height: 1.14;
}

.ecosystem-story p {
  max-width: 42rem;
  margin: 0;
  color: var(--color-text-secondary);
  font-size: clamp(0.9rem, 1.1vw, 0.98rem);
  line-height: 1.48;
}

.ecosystem-story--scholar {
  --story-bg: rgb(116 43 57 / 0.08);
  --story-glow: rgb(116 43 57 / 0.24);
}

.ecosystem-story--network {
  --story-bg: rgb(62 86 119 / 0.08);
  --story-glow: rgb(62 86 119 / 0.22);
}

.ecosystem-story--venue {
  --story-bg: rgb(185 137 68 / 0.1);
  --story-glow: rgb(185 137 68 / 0.28);
}

.ecosystem-story--research {
  --story-bg: rgb(20 24 33 / 0.06);
  --story-glow: rgb(116 43 57 / 0.2);
}

.ecosystem-loop {
  margin: 0.15rem 0 0;
  color: var(--color-primary-dark);
  font-family: var(--font-serif);
  font-size: clamp(1.2rem, 2vw, 1.55rem);
  font-style: italic;
  line-height: 1.25;
  text-align: center;
}

.home-context {
  padding-block: 0.75rem 0;
}

.home-context__inner {
  display: grid;
  gap: 0.9rem;
  padding: clamp(1.1rem, 2.4vw, 1.65rem);
  border: 1px solid rgb(255 255 255 / 0.7);
  border-radius: 28px;
  background:
    radial-gradient(circle at top right, rgb(185 137 68 / 0.12), transparent 28%),
    linear-gradient(180deg, rgb(255 255 255 / 0.84), rgb(255 255 255 / 0.7));
  box-shadow: var(--shadow-soft);
}

.home-context h2 {
  max-width: 16ch;
  margin-bottom: 0.55rem;
  font-size: clamp(1.55rem, 2.6vw, 2.25rem);
}

.home-context__intro p {
  max-width: 48rem;
  margin-bottom: 0;
  color: var(--color-text-secondary);
  line-height: 1.62;
}

.support-grid {
  display: grid;
  gap: 0.7rem;
}

.support-card {
  position: relative;
  display: grid;
  min-height: 12rem;
  gap: 0.42rem;
  align-content: start;
  padding: 1.25rem 1.2rem 1.25rem 4rem;
  border: 1px solid rgb(20 24 33 / 0.1);
  border-radius: 18px;
  background: rgb(255 255 255 / 0.6);
  color: var(--color-text-primary);
}

.support-card::after {
  position: absolute;
  inset: 0.65rem;
  border-radius: 14px;
  border: 1px solid transparent;
  content: '';
  pointer-events: none;
  transition: border-color var(--transition-base);
}

.support-card:hover {
  color: var(--color-text-primary);
  transform: translateY(-2px);
  box-shadow: var(--shadow-soft);
}

.support-card:hover::after {
  border-color: rgb(116 43 57 / 0.16);
}

.support-card__index {
  position: absolute;
  top: 1.22rem;
  left: 1.15rem;
  display: inline-grid;
  width: 2.25rem;
  height: 2.25rem;
  place-items: center;
  border-radius: 50%;
  background: rgb(116 43 57 / 0.08);
  color: var(--color-primary-dark);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 700;
}

.support-card__kicker {
  color: var(--color-primary);
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.support-card strong {
  font-size: clamp(1.12rem, 1.6vw, 1.28rem);
  line-height: 1.22;
}

.support-card p {
  margin: 0;
  color: var(--color-text-secondary);
  font-size: 0.94rem;
  line-height: 1.58;
}

:global(.site-footer) {
  margin-top: 1.25rem;
}

:global(.site-main) {
  padding-bottom: 0.75rem;
}

@media (min-width: 760px) {
  .home-hero__inner {
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);
  }

  .home-hero__media {
    min-height: 560px;
  }

  .pillar-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ecosystem-story {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ecosystem-story--reverse .ecosystem-story__body {
    order: -1;
  }
}

@media (min-width: 1020px) {
  .home-hero__inner {
    grid-template-columns: minmax(0, 1.58fr) minmax(320px, 0.62fr);
  }

  .ecosystem-stories {
    gap: 0.78rem;
  }

