          <div>
            <strong class="award__title">
              ACS Best Paper Award (1st Runner-Up) in the 31st Australasian Conference
              on Information Systems
            </strong>
          </div>
        </div>
        <div class="award">
          <span class="award__year">2020</span>
          <div>
            <strong class="award__title">
              2019 College of SEH Recognition of Outstanding Student Experience (ROSE)
              Award (COSC2130 Professional Computing Practice)
            </strong>
          </div>
        </div>
        <div class="award">
          <span class="award__year">2020</span>
          <div>
            <strong class="award__title">
              2019 College of SEH Recognition of Outstanding Student Experience (ROSE)
