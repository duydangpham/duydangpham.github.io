---
import BaseLayout from '../layouts/BaseLayout.astro';
import { personSchema } from '../data/schema-person';
import { hasProfilePortrait, profilePortraitSrc } from '../utils/portrait';

const title = 'Giới thiệu';
const description =
  'Giới thiệu Dr. Duy Dang-Pham, Senior Lecturer tại RMIT University Vietnam, Co-founder của NetIQ và Fulbright Scholar-in-Residence 2024.';
const canonicalUrl = '/gioi-thieu';
---

<BaseLayout
  title={title}
  description={description}
  lang="vi"
  canonicalUrl={canonicalUrl}
  jsonLd={personSchema}
>
  <div class="container about-page">

    <!-- ── Page header ── -->
    <header class="page-header">
      <div class="page-header__photo-wrap">
        {hasProfilePortrait && profilePortraitSrc ? (
          <img
            class="page-header__photo"
            src={profilePortraitSrc}
            alt="Dr. Duy Dang-Pham"
            width="180"
            height="220"
            loading="eager"
          />
        ) : (
          <div class="page-header__photo-fallback" aria-hidden="true">DD</div>
        )}
      </div>
      <div class="page-header__text">
        <h1 class="page-header__name">Dr. Duy Dang-Pham</h1>
        <p class="page-header__titles">
          Associate Head of Department (Research &amp; Innovation) · Senior Lecturer in MIS<br />
          <strong>RMIT University Vietnam</strong>
        </p>
        <p class="page-header__titles">
          Co-founder &amp; CEO<br />
          <strong>NetIQ</strong>
        </p>
        <div class="page-header__badges">
          <span class="badge">Fulbright Scholar-in-Residence 2024</span>
          <span class="badge badge--accent">70+ Công bố khoa học</span>
        </div>
      </div>
    </header>

    <!-- ── Biography ── -->
    <section class="prose-section">
      <h2>Tiểu sử</h2>
      <div class="bio-copy">
        <p>
          Tổ chức nào cũng có hai cấu trúc: một trên sơ đồ tổ chức, và một thật sự quyết định
          tri thức chảy đi đâu, niềm tin được xây dựng ra sao, và một công nghệ mới sẽ bén rễ
          hay lặng lẽ chết đi. <strong>Công việc của tôi là về cấu trúc thứ hai.</strong>
        </p>

        <p>
          Tôi là Dr. Duy Dang-Pham — Associate Head of Department (Research &amp; Innovation)
          kiêm Senior Lecturer ngành Management Information Systems tại RMIT University Vietnam,
          đồng sáng lập <strong>NetIQ</strong>, và là một nhà nghiên cứu đã dành 15 năm để theo đuổi
          một câu hỏi duy nhất: <em>Mạng lưới con người bên trong tổ chức định hình cách công nghệ
          được tiếp nhận, tri thức được chia sẻ, và an ninh thông tin được duy trì như thế nào?</em>
        </p>
        <p>
          Cách tiếp cận của tôi có chủ đích <strong>lấy con người làm trung tâm</strong>. Trong một
          thời điểm mà các tổ chức đang chịu áp lực rất lớn để áp dụng AI, tôi quan tâm đến
          con người phải vận hành công nghệ đó nhiều hơn là bản thân công nghệ. AI thành công
          hay thất bại không phải vì thuật toán — mà vì liệu đúng người, ở đúng vị trí ảnh hưởng
          phi chính thức, có tin vào nó và mang nó đi tiếp hay không. ONA cho chúng ta một cách
          nghiêm ngặt, dựa trên bằng chứng, để tìm ra những người đó và trao quyền cho họ.
          <em>Đó là điều tôi muốn nói khi nhắc đến network intelligence.</em>
        </p>

        <p>Nghiên cứu của tôi trải rộng trên ba lĩnh vực liên kết với nhau:</p>
        <ul>
          <li><em>quản trị an ninh thông tin</em> — tìm hiểu lý do con người tuân thủ hoặc vi phạm chính sách bảo mật, và cách tổ chức xây dựng văn hoá an ninh tích cực;</li>
          <li><em>phân tích mạng lưới tổ chức</em> — phương pháp multiplex ONA lập bản đồ năm lớp quan hệ cùng lúc để cho thấy tổ chức thực sự vận hành ra sao; và</li>
          <li><em>chiến lược áp dụng AI</em> — bao gồm việc xác định các hình mẫu AI champion thúc đẩy sự áp dụng từ cấp cơ sở.</li>
        </ul>
        <p>  
          Được thực hiện chủ yếu trong bối cảnh Việt Nam và Đông Nam Á, công trình này đã tạo ra
          hơn <strong>70 công bố khoa học được bình duyệt</strong> trên các tạp chí học thuật uy tín
          như <em>Computers in Human Behavior</em>, <em>Information &amp; Management</em>,
          <em>Information Systems Frontiers</em>, và <em>Computers &amp; Security</em>, cùng ba tập sách
          đồng biên tập trong bộ <em>Information Systems Research in Vietnam</em>.
        </p>

        <p>
          Nếu bạn đang dẫn dắt một tổ chức trải qua giai đoạn áp dụng AI hoặc chuyển đổi số,
          câu hỏi tôi nghe nhiều nhất là: <em>"Chúng tôi đã làm đúng mọi thứ trên giấy — vậy tại
          sao vẫn không hiệu quả?"</em> Câu trả lời hầu như luôn nằm ở mạng lưới. Những champion
          bạn chỉ định không thật sự có ảnh hưởng phi chính thức. Tri thức bạn nghĩ đang chảy
          tự do thực ra đang đọng lại thành từng silo riêng lẻ. Sự kháng cự bạn gặp phải không
          hề vô lý — nó phản ánh những cấu trúc quan hệ mà chiến lược chưa bao giờ tính đến.
        </p>
        <p>
          <strong>NetIQ tồn tại để làm cho những cấu trúc đó trở nên hữu hình</strong>, và giúp bạn
          thiết kế những can thiệp thuận theo cấu trúc thật của tổ chức — chứ không đi ngược lại nó.
        </p>

        <ul>
          <li><strong>Xem nghiên cứu</strong> — <a href="/nghien-cuu">Nghiên cứu và công bố</a></li>
          <li><strong>Làm việc cùng NetIQ</strong> — <a href="/tu-van">Tư vấn / Giải pháp</a></li>
          <li><strong>Mời chia sẻ</strong> — <a href="/dien-thuyet">Diễn thuyết</a></li>
        </ul>
      </div>
    </section>

    <!-- ── Positions ── -->
    <section class="prose-section">
      <h2>Quá trình học thuật &amp; chuyên môn</h2>
      <div class="timeline">
        <div class="timeline__item">
          <span class="timeline__period">Tháng 1/2025 – Hiện tại</span>
          <div class="timeline__content">
            <strong class="timeline__role">Associate Head of Department — Research &amp; Innovation</strong>
            <span class="timeline__org">RMIT University Vietnam · TP. Hồ Chí Minh, Việt Nam</span>
            <p class="timeline__detail">
              Trong vai trò lãnh đạo cấp cao này tại The Business School, tôi phụ trách chiến lược
              nghiên cứu và chương trình đổi mới của khoa — thúc đẩy chất lượng nghiên cứu, xây dựng
              năng lực học thuật, mở rộng kết nối với doanh nghiệp và cộng đồng, và củng cố vị thế
              của RMIT Việt Nam như một cơ sở nghiên cứu hàng đầu khu vực Đông Nam Á.
            </p>
          </div>
        </div>
        <div class="timeline__item">
          <span class="timeline__period">Tháng 1/2022 – Tháng 1/2025</span>
          <div class="timeline__content">
            <strong class="timeline__role">HDR Coordinator &amp; Senior Program Manager — PhD Programs</strong>
            <span class="timeline__org">RMIT University Vietnam · TP. Hồ Chí Minh, Việt Nam</span>
            <p class="timeline__detail">
              Với vai trò HDR Coordinator và Designated Authority cho chương trình Higher Degree by
              Research tại The Business School, tôi dẫn dắt và cố vấn cho cả nghiên cứu sinh tiến sĩ
              lẫn giảng viên hướng dẫn, duy trì chuẩn mực HDR của trường, và định hình chiến lược
              đào tạo tiến sĩ riêng cho khoa — hỗ trợ thế hệ nhà nghiên cứu tiếp theo trong lĩnh vực
              hệ thống thông tin, kinh doanh số và các ngành liên quan.
            </p>
          </div>
        </div>
        <div class="timeline__item">
          <span class="timeline__period">Tháng 6/2021 – Hiện tại</span>
          <div class="timeline__content">
            <strong class="timeline__role">Senior Lecturer — Digital Marketing &amp; Information Systems</strong>
            <span class="timeline__org">RMIT University Vietnam · TP. Hồ Chí Minh, Việt Nam</span>
            <p class="timeline__detail">
              Giảng dạy và nghiên cứu trong các lĩnh vực chuyển đổi số, phân tích dữ liệu và hệ thống
              thông tin tại RMIT University Vietnam. Những đóng góp chính trong vai trò này gồm:
              đồng sáng lập Vietnam Chapter của Association for Information Systems (VAIS); cùng nhóm
              nghiên cứu nhận được khoản tài trợ bên ngoài khoảng 220.000 USD cho nghiên cứu ứng dụng
              phân tích dữ liệu mạng xã hội nhằm hỗ trợ tiêm chủng cho người khuyết tật; và đồng biên
              tập một series sách của Springer về nghiên cứu hệ thống thông tin tại Việt Nam.
            </p>
          </div>
        </div>
        <div class="timeline__item">
          <span class="timeline__period">Tháng 1/2024 – Hiện tại</span>
          <div class="timeline__content">
            <strong class="timeline__role">Visiting Lecturer — MBA</strong>
            <span class="timeline__org">Western Sydney University Vietnam</span>
            <p class="timeline__detail">
              Giảng dạy học phần MBA <em>Innovation Through Digital Technology</em> (BUSM7045),
              trang bị cho các nhà quản lý cấp cao những khung lý thuyết và công cụ để dẫn dắt
              đổi mới dựa trên công nghệ trong tổ chức của họ.
            </p>
          </div>
        </div>
        <div class="timeline__item">
          <span class="timeline__period">Tháng 7/2021 – Hiện tại</span>
          <div class="timeline__content">
            <strong class="timeline__role">Co-Founder &amp; Secretary</strong>
            <span class="timeline__org">Vietnam Chapter of the Association for Information Systems (VAIS) · TP. Hồ Chí Minh, Việt Nam</span>
            <p class="timeline__detail">
              Đồng sáng lập VAIS, chi hội Việt Nam của Association for Information Systems — hiệp hội
              chuyên môn hàng đầu thế giới về nghiên cứu, giảng dạy và thực hành hệ thống thông tin.
              Dưới sự dẫn dắt của VAIS, TP. Hồ Chí Minh đã đăng cai Pacific Asia Conference on
              Information Systems (PACIS 2024) — hội nghị nghiên cứu và công nghiệp về hệ thống
              thông tin lớn nhất khu vực châu Á - Thái Bình Dương.
            </p>
          </div>
        </div>
        <div class="timeline__item">
          <span class="timeline__period">Tháng 12/2023 – Hiện tại</span>
          <div class="timeline__content">
            <strong class="timeline__role">Consultant — Digital Transformation &amp; Standards Adoption</strong>
            <span class="timeline__org">BSI (British Standards Institution) · Làm việc từ xa</span>
            <p class="timeline__detail">
              Thực hiện nghiên cứu độc lập và đánh giá nhu cầu về chuyển đổi số cùng việc áp dụng
              các tiêu chuẩn quốc tế tại Việt Nam, làm việc với các chuyên gia ở cả khu vực tư nhân
              và công thông qua phỏng vấn chuyên sâu và workshop, nhằm cung cấp thông tin cho hoạt
              động tư vấn và phát triển tiêu chuẩn của BSI trong khu vực.
            </p>
          </div>
        </div>
        <div class="timeline__item">
          <span class="timeline__period">Tháng 8/2024 – Tháng 1/2025</span>
          <div class="timeline__content">
            <strong class="timeline__role">Fulbright U.S. Scholar-in-Residence</strong>
            <span class="timeline__org">Gonzaga University / The Fulbright Program · Spokane, Washington, USA</span>
            <p class="timeline__detail">
              Được bổ nhiệm làm Fulbright Scholar-in-Residence tại Gonzaga University trong khuôn khổ
              Fulbright Scholar Program của Bộ Ngoại giao Hoa Kỳ — giảng dạy, tổ chức workshop và
              seminar nghiên cứu về chiến lược AI, phân tích mạng lưới tổ chức (ONA) và chuyển đổi số
              cho sinh viên và giảng viên, đồng thời mở rộng góc nhìn liên văn hoá về việc tiếp nhận
              công nghệ và thay đổi tổ chức.
            </p>
          </div>
        </div>
        <div class="timeline__item">
          <span class="timeline__period">Tháng 5/2023 – Tháng 11/2023</span>
          <div class="timeline__content">
            <strong class="timeline__role">Visiting Lecturer — Data Analytics for Business</strong>
            <span class="timeline__org">UEH International School of Business</span>
            <p class="timeline__detail">
              Giảng dạy học phần trực tuyến <em>Data Analytics for Business</em>, trang bị cho học viên
              sau đại học kỹ năng thực tế trong việc ra quyết định dựa trên dữ liệu và các công cụ
              phân tích ứng dụng trong kinh doanh.
            </p>
          </div>
        </div>
        <div class="timeline__item">
          <span class="timeline__period">Tháng 5/2020 – Tháng 6/2021</span>
          <div class="timeline__content">
            <strong class="timeline__role">Senior Program Manager — Software Engineering &amp; Information Technology</strong>
            <span class="timeline__org">RMIT University Vietnam</span>
            <p class="timeline__detail">
              Dẫn dắt hai chương trình đào tạo lớn nhất tại School of Science, Engineering &amp;
              Technology của RMIT Việt Nam — Bachelor of Engineering (Software Engineering) (Honours)
              và Bachelor of Information Technology — quản lý đội ngũ 18 giảng viên trong khi vẫn
              duy trì tăng trưởng tuyển sinh suốt đại dịch COVID-19, mở rộng đội ngũ giảng dạy từ
              9 lên 18 người chỉ trong 5 tháng, và dẫn dắt việc ra mắt thành công chương trình
              Bachelor of IT tại Hà Nội, năm chuyên ngành phụ (Minor) mới tại Việt Nam, và chương
              trình tiến sĩ ngành Computer Science and IT tại RMIT Việt Nam. Duy trì quan hệ chiến
              lược với hơn 20 đối tác doanh nghiệp bao gồm Microsoft, IBM, Ericsson, VNG, KMS
              Technology, ABB, Bosch, và Intel. Được vinh danh với giải thưởng "Living RMIT's
              Values" năm 2021.
            </p>
          </div>
        </div>
        <div class="timeline__item">
          <span class="timeline__period">Tháng 6/2018 – Tháng 6/2021</span>
          <div class="timeline__content">
            <strong class="timeline__role">Lecturer — Information Technology</strong>
            <span class="timeline__org">RMIT University Vietnam · Việt Nam</span>
            <p class="timeline__detail">
              Đảm nhiệm vai trò Research Cluster Lead (Computing Technologies) và Stream Lead (Data
              Science &amp; Artificial Intelligence) tại School of Science and Technology, giảng dạy và
              điều phối các học phần bao gồm User-centred Design, Machine Learning, Technology
              Leadership, và Practical Data Science. Thực hiện nghiên cứu về hành vi an ninh thông
              tin, phân tích mạng lưới xã hội và quản trị đổi mới; hướng dẫn nghiên cứu sinh tiến sĩ;
              nhận được 71.000 USD tài trợ nghiên cứu; và duy trì quan hệ hợp tác tích cực với các
              doanh nghiệp như Grab, Lazada, Alibaba, VNG, và Zalo.
            </p>
          </div>
        </div>
        <div class="timeline__item">
          <span class="timeline__period">Tháng 3/2014 – Tháng 2/2017</span>
          <div class="timeline__content">
            <strong class="timeline__role">PhD Candidate &amp; Teaching Assistant</strong>
            <span class="timeline__org">RMIT University · Melbourne, Australia</span>
            <p class="timeline__detail">
              Hoàn thành nghiên cứu tiến sĩ về an ninh thông tin và phân tích mạng lưới xã hội, đồng
              thời hỗ trợ giảng dạy các học phần logistics và quản trị chuỗi cung ứng theo cả hình thức
              trực tuyến lẫn trực tiếp — phục vụ khoảng 100 sinh viên mỗi học kỳ, bao gồm cả sinh viên
              đang thụ án và sinh viên ở vùng nông thôn có kết nối internet hạn chế. Góp phần nâng mức
              độ hài lòng của sinh viên với học phần <em>Supply Chain Analysis and Design</em> lên trên
              90% trong Học kỳ 2 năm 2014, đóng góp vào giải thưởng College of Business Recognition
              Award của cả nhóm.
            </p>
          </div>
        </div>
        <div class="timeline__item">
          <span class="timeline__period">Tháng 2/2011 – Tháng 2/2012</span>
          <div class="timeline__content">
            <strong class="timeline__role">Business Systems Analyst</strong>
            <span class="timeline__org">TRG International · Việt Nam</span>
            <p class="timeline__detail">
              Triển khai các hệ thống ERP tài chính và bán lẻ (SunSystems và RetailPro) cho khách hàng
              doanh nghiệp tại Việt Nam — phân tích yêu cầu nghiệp vụ, thiết kế công cụ tiện ích
              (add-in), tư vấn kiến trúc hệ thống, và đào tạo người dùng nội bộ lẫn bên ngoài.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Education ── -->
    <section class="prose-section">
      <h2>Học vấn</h2>
      <div class="edu-list">
        <div class="edu-item">
          <span class="edu-item__degree">Doctor of Philosophy (PhD), Business Information Systems</span>
          <span class="edu-item__institution">RMIT University, Australia</span>
        </div>
        <div class="edu-item">
          <span class="edu-item__degree">Bachelor of Business (Honours), Honours First Class</span>
          <span class="edu-item__institution">RMIT University, Australia</span>
        </div>
        <div class="edu-item">
          <span class="edu-item__degree">Bachelor of Business (Business Information Systems) with Distinction</span>
          <span class="edu-item__institution">RMIT University Vietnam, Việt Nam</span>
        </div>
      </div>
    </section>

    <!-- ── Awards ── -->
    <section class="prose-section">
      <h2>Giải thưởng &amp; Danh hiệu</h2>
      <div class="awards">
        <div class="award">
          <span class="award__year">2021</span>
          <div>
            <strong class="award__title">2021 Living RMIT Values Award</strong>
          </div>
        </div>
        <div class="award">
