---
import PublicationItem from '../components/PublicationItem.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublications, groupPublicationsByYear } from '../utils/publications';

const title = 'Công bố khoa học';
const description =
  'Các bài báo khoa học, kỷ yếu hội nghị và chương sách của Tiến sĩ Duy Đặng về phân tích mạng lưới tổ chức, chiến lược AI, an ninh thông tin và chuyển đổi số.';
const canonicalUrl = '/cong-bo-khoa-hoc/';

const publications = await getPublications();
const groupedPublications = groupPublicationsByYear(publications);
const yearAnchors = groupedPublications.map(([year]) => year);
const hasPublications = publications.length > 0;
const latestYear = yearAnchors[0];
const earliestYear = yearAnchors.at(-1);
const venueCount = new Set(
  publications.map((publication) => publication.data.journal).filter(Boolean),
).size;
---

<BaseLayout
  title={title}
  description={description}
  lang="vi"
  canonicalUrl={canonicalUrl}
>
  <div class="container publications-page" data-publications-root>
    <header class="publication-intro">
      <div class="publication-intro__copy">
        <p class="publication-eyebrow">Công bố khoa học</p>
        <h1>Danh sách công bố, bài báo và chương sách.</h1>
        <p class="lead">
          Một kho lưu trữ có thể tra cứu các bài báo phản biện, kỷ yếu hội nghị và chương
          sách của tôi về hệ thống thông tin, an ninh thông tin, mạng lưới tổ chức, AI và
          chuyển đổi số.
        </p>
        <div class="publication-intro__links">
          <a
            class="btn btn--primary"
            href="https://scholar.google.com.vn/citations?user=lkYFFvAAAAAJ"
            target="_blank"
            rel="noopener noreferrer"
          >
            Google Scholar
          </a>
          <a
            class="btn btn--secondary"
            href="https://orcid.org/0000-0002-7798-6635"
            target="_blank"
            rel="noopener noreferrer"
          >
            ORCID
          </a>
        </div>
      </div>

      {hasPublications && (
        <div class="publication-stats" aria-label="Publication summary">
          <div>
            <span>{publications.length}</span>
            <p>Công bố</p>
          </div>
          <div>
            <span>{latestYear}–{earliestYear}</span>
            <p>Giai đoạn</p>
          </div>
          <div>
            <span>{venueCount}</span>
            <p>Nơi công bố</p>
          </div>
        </div>
      )}
    </header>

    {hasPublications ? (
      <>
        <section class="publication-toolbar" aria-label="Công cụ lọc công bố">
          <div class="publication-toolbar__search">
            <label class="publication-toolbar__label" for="publication-filter">
              Lọc công bố
            </label>
            <input
              id="publication-filter"
              class="publication-toolbar__input"
              type="search"
              placeholder="Tìm theo tiêu đề, tác giả, nơi công bố, từ khoá hoặc tóm tắt"
              autocomplete="off"
              data-publication-filter
            />
          </div>

          <div class="publication-toolbar__meta">
            <p class="publication-toolbar__count" data-publication-count>
              {publications.length} công bố
            </p>
          </div>
        </section>

        <div class="publication-layout">
          {yearAnchors.length > 0 && (
            <aside class="publication-years">
              <p>Đi đến năm</p>
              <nav aria-label="Chuyển đến năm công bố">
                {yearAnchors.map((year) => (
                  <a class="publication-years__link" href={`#year-${year}`}>
                    {year}
                  </a>
                ))}
              </nav>
            </aside>
          )}

          <div class="publication-results">
            <p class="publication-filter-empty" hidden data-filter-empty role="status">
              Không có công bố nào khớp với tìm kiếm. Hãy thử từ khoá khác.
            </p>

            {groupedPublications.map(([year, items]) => (
              <section class="year-group" id={`year-${year}`} data-year-group>
                <div class="year-group__header">
                  <h2 class="year-group__heading">{year}</h2>
                  <span>{items.length} công bố</span>
                </div>
                <ol class="publication-list">
                  {items.map((publication) => (
                    <li class="publication-list__item pub-item" data-publication-item>
                      <PublicationItem publication={publication} />
                    </li>
                  ))}
                </ol>
              </section>
            ))}
          </div>
        </div>

        <div class="scholar-cta">
          <p>Cần xem chỉ số trích dẫn, mạng lưới đồng tác giả hoặc hồ sơ đầy đủ hơn?</p>
          <div class="scholar-cta__links">
            <a
              class="cta-btn cta-btn--primary"
              href="https://scholar.google.com.vn/citations?user=lkYFFvAAAAAJ"
              target="_blank"
              rel="noopener noreferrer"
            >
              Google Scholar
            </a>
            <a
              class="cta-btn cta-btn--outline"
              href="https://orcid.org/0000-0002-7798-6635"
              target="_blank"
              rel="noopener noreferrer"
            >
              ORCID
            </a>
          </div>
        </div>
      </>
    ) : (
      <div class="empty-state">
        <h2 class="empty-state__title">Kho công bố đang được hoàn thiện</h2>
        <p class="empty-state__body">
          Tôi đang chuẩn bị kho công bố đầy đủ cho website này. Trong lúc đó, vui lòng xem
          Google Scholar hoặc ORCID để có danh sách cập nhật nhất.
        </p>
        <div class="empty-state__actions">
          <a
            class="cta-btn cta-btn--primary"
            href="https://scholar.google.com.vn/citations?user=lkYFFvAAAAAJ"
            target="_blank"
            rel="noopener noreferrer"
          >
            Google Scholar
          </a>
          <a
            class="cta-btn cta-btn--outline"
            href="https://orcid.org/0000-0002-7798-6635"
            target="_blank"
            rel="noopener noreferrer"
          >
            ORCID
          </a>
        </div>
      </div>
    )}
  </div>

  <script is:inline>
    const initPublicationFilter = () => {
      const root = document.querySelector('[data-publications-root]');

      if (!(root instanceof HTMLElement) || root.dataset.filterReady === 'true') {
        return;
      }

      root.dataset.filterReady = 'true';

      const input = root.querySelector('[data-publication-filter]');
      const items = [...root.querySelectorAll('[data-publication-item]')];
      const groups = [...root.querySelectorAll('[data-year-group]')];
      const count = root.querySelector('[data-publication-count]');
      const empty = root.querySelector('[data-filter-empty]');

      if (!(input instanceof HTMLInputElement)) {
        return;
      }

      const update = () => {
        const query = input.value.trim().toLowerCase();
        const hasQuery = query.length > 0;
        let visibleCount = 0;

        items.forEach((item) => {
          if (!(item instanceof HTMLElement)) {
            return;
          }

          const searchable =
            item.querySelector('[data-publication-search]')?.dataset.publicationSearch ?? '';
          const matches = query === '' || searchable.includes(query);

          item.hidden = !matches;

          if (matches) {
            visibleCount += 1;
          }
        });

        groups.forEach((group) => {
          if (!(group instanceof HTMLElement)) {
            return;
          }

          const hasVisibleItems = group.querySelector('[data-publication-item]:not([hidden])');
          group.hidden = !hasVisibleItems;
        });

        if (count instanceof HTMLElement) {
          count.textContent = `${visibleCount} công bố`;
        }

        if (empty instanceof HTMLElement) {
          empty.hidden = !(hasQuery && visibleCount === 0);
        }
      };

      input.addEventListener('input', update);
      update();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPublicationFilter, { once: true });
    } else {
      initPublicationFilter();
    }

    document.addEventListener('astro:page-load', initPublicationFilter);
  </script>
</BaseLayout>

<style>
.publications-page {
  display: grid;
  gap: 1rem;
}

.publication-intro,
.publication-toolbar,
.publication-years,
.scholar-cta {
  overflow: hidden;
  border: 1px solid rgb(255 255 255 / 0.72);
  border-radius: 28px;
  background:
    radial-gradient(circle at top right, rgb(185 137 68 / 0.12), transparent 28%),
    linear-gradient(180deg, rgb(255 255 255 / 0.86), rgb(255 255 255 / 0.7));
  box-shadow: var(--shadow-soft);
  backdrop-filter: blur(calc(var(--glass-blur) - 2px)) saturate(120%);
}

.publication-intro {
  display: grid;
  gap: clamp(1.2rem, 3vw, 2rem);
  align-items: end;
  padding: clamp(1.15rem, 2.6vw, 1.7rem);
}

.publication-intro__copy {
  min-width: 0;
}

.publication-eyebrow,
.publication-toolbar__label,
.publication-years p {
  margin-bottom: 0.7rem;
  color: var(--color-primary);
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.publication-intro h1 {
  max-width: 18ch;
  font-size: clamp(2rem, 3.8vw, 3.35rem);
  line-height: 1.03;
}

.publication-intro .lead {
  max-width: 68ch;
  margin-bottom: 1rem;
}

.publication-intro__links,
.scholar-cta__links,
.empty-state__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
}

.publication-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.7rem;
}

.publication-stats div {
  min-width: 0;
  padding: 1rem;
  border: 1px solid rgb(255 255 255 / 0.72);
  border-radius: 20px;
  background: rgb(255 255 255 / 0.72);
}

.publication-stats span {
  display: block;
  margin-bottom: 0.28rem;
  color: var(--color-text-primary);
  font-size: clamp(1.35rem, 2.4vw, 1.85rem);
  font-weight: 750;
  letter-spacing: -0.04em;
  line-height: 1;
}

.publication-stats p {
  margin: 0;
  color: var(--color-text-muted);
  font-size: 0.82rem;
  font-weight: 700;
}

.publication-toolbar {
  display: grid;
  gap: 1rem;
  padding: clamp(1rem, 2.4vw, 1.35rem);
}

.publication-toolbar__search {
  display: grid;
  gap: 0.6rem;
}

.publication-toolbar__label {
  margin-bottom: 0;
}

.publication-toolbar__input {
  width: 100%;
  min-height: 3.1rem;
  padding: 0.9rem 1rem;
  border: 1px solid rgb(20 24 33 / 0.1);
  border-radius: 18px;
  background: rgb(255 255 255 / 0.88);
  color: var(--color-text-primary);
  box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.86);
}

.publication-toolbar__input::placeholder {
  color: var(--color-text-muted);
}

.publication-toolbar__meta {
  display: grid;
  gap: 0.8rem;
  align-content: end;
}

.publication-toolbar__count {
  margin: 0;
  color: var(--color-text-secondary);
  font-size: 0.92rem;
  font-weight: 700;
}

.publication-filter-empty {
  margin: 0 0 1rem;
  padding: 1rem 1.2rem;
  border: 1px solid rgb(116 43 57 / 0.12);
  border-radius: 18px;
  background: rgb(116 43 57 / 0.06);
  color: var(--color-text-secondary);
  font-size: var(--text-sm);
  line-height: 1.6;
  text-align: center;
}

.publication-layout {
  display: grid;
  gap: 1rem;
  align-items: start;
}

.publication-years {
  display: none;
  padding: 1rem;
}

.publication-years p {
  margin: 0;
}

.publication-years nav {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
}

.publication-years__link {
  display: inline-flex;
  align-items: center;
  min-height: 2.25rem;
  padding: 0.38rem 0.7rem;
  border: 1px solid rgb(20 24 33 / 0.08);
  border-radius: var(--radius-pill);
  background: rgb(255 255 255 / 0.76);
  color: var(--color-text-secondary);
  font-size: 0.82rem;
  font-weight: 700;
}

.publication-years__link:hover {
  border-color: rgb(116 43 57 / 0.22);
  color: var(--color-primary);
}

.publication-results {
  min-width: 0;
}

.publications-page .year-group {
  display: grid;
  gap: 0.75rem;
  margin-bottom: 1rem;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.year-group__header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.15rem 0.25rem;
}

.year-group__heading {
  margin: 0;
  color: var(--color-primary-dark);
  font-family: var(--font-sans);
  font-size: clamp(1.4rem, 2.4vw, 1.95rem);
  font-weight: 750;
  letter-spacing: -0.04em;
}

.year-group__header span {
  flex-shrink: 0;
  color: var(--color-text-muted);
  font-size: 0.82rem;
  font-weight: 700;
}

.publication-list {
  display: grid;
  gap: 0.78rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.publication-list__item {
  margin: 0;
}

.publications-page .pub-item {
  padding: clamp(0.95rem, 2vw, 1.25rem);
  border-color: rgb(20 24 33 / 0.1);
  border-radius: 22px;
  background:
    linear-gradient(180deg, rgb(255 255 255 / 0.9), rgb(255 255 255 / 0.78)),
    var(--color-surface);
}

.scholar-cta {
  padding: clamp(1.1rem, 2.4vw, 1.5rem);
  text-align: center;
}

.scholar-cta p {
  margin: 0 0 var(--space-md);
  color: var(--color-text-secondary);
}

@media (min-width: 768px) {
  .publication-intro {
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
  }

  .publication-toolbar {
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
    align-items: end;
  }

  .publication-toolbar__meta {
    justify-items: end;
    text-align: right;
  }
}

@media (min-width: 1024px) {
  .publication-layout {
    grid-template-columns: 12rem minmax(0, 1fr);
  }

  .publication-years {
    position: sticky;
    top: 6.8rem;
    display: block;
  }
}

@media (max-width: 767px) {
  .publication-stats {
    grid-template-columns: 1fr;
  }

  .publication-intro__links,
  .scholar-cta__links,
  .empty-state__actions {
    align-items: stretch;
    flex-direction: column;
  }
}
</style>
